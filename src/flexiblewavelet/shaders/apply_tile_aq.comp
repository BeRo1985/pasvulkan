#version 450
// apply_tile_aq.comp — GPU side of AQ (per-tile adaptive quantization), fully on the GPU. For each coefficient it
// finds its Mallat subband + tile (exactly the same walk as the CPU ApplyTileAQ / BuildQuantizationSteps), reads the
// transmitted per-tile code straight from the (raw, packed) qpmap bytes, looks up its weight, and writes
// weight*base_step (rounded, >=1) into the modulated step map the dequant pass then reads. Runs ONLY under --aq, so
// the dequant shader stays untouched; per frame the host only memcpy-uploads the tiny raw qpmap byte slice (no CPU
// computation at all — the old per-pixel CPU step modulation is gone). The weight LUT is computed once on the CPU
// (aq_weight_from_code) and uploaded once, so there is no GPU exp/log and the result is bit-identical to the CPU path.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer BaseSteps      { int base_steps[]; };           // per-quality step map (cached)
layout(std430, binding = 1) readonly buffer TileCodes      { uint tile_codes_packed[]; };    // raw qpmap bytes, 4 codes per uint (per frame)
layout(std430, binding = 2) readonly buffer WeightLUT      { float weight_lut[]; };           // 256 log-spaced weights (uploaded once)
layout(std430, binding = 3)          buffer ModulatedSteps { int modulated_steps[]; };        // output: the step the dequant reads
layout(push_constant) uniform PushConstants { int width; int height; int levels; int tile_cols; int tile_rows; } push;

void main() {
  uint gid = gl_GlobalInvocationID.x;
  if (gid >= uint(push.width * push.height)) {
    return;
  }
  int x = int(gid) % push.width;
  int y = int(gid) / push.width;

  // Walk the Mallat layout to find this coefficient's detail subband (or the final LL), then its normalised tile.
  int current_width = push.width, current_height = push.height;
  int tile_column = 0, tile_row = 0;
  bool placed = false;
  for (int level = 0; ((level < push.levels) && (current_width >= 2)) && (current_height >= 2); level++) {
    int half_width = (current_width + 1) / 2, half_height = (current_height + 1) / 2;
    bool in_right = (x >= half_width), in_bottom = (y >= half_height);
    if (in_right || in_bottom) {
      int sub_x = in_right ? (x - half_width) : x;
      int sub_y = in_bottom ? (y - half_height) : y;
      int sub_w = in_right ? (current_width - half_width) : half_width;
      int sub_h = in_bottom ? (current_height - half_height) : half_height;
      tile_column = (sub_w > 0) ? ((sub_x * push.tile_cols) / sub_w) : 0;
      tile_row    = (sub_h > 0) ? ((sub_y * push.tile_rows) / sub_h) : 0;
      placed = true;
      break;
    }
    current_width = half_width;
    current_height = half_height;
  }
  if (!placed) {   // the final LL
    tile_column = (current_width  > 0) ? ((x * push.tile_cols) / current_width)  : 0;
    tile_row    = (current_height > 0) ? ((y * push.tile_rows) / current_height) : 0;
  }
  if (tile_column >= push.tile_cols) { tile_column = push.tile_cols - 1; }
  if (tile_row    >= push.tile_rows) { tile_row    = push.tile_rows - 1; }

  int tile = (tile_row * push.tile_cols) + tile_column;
  uint code = (tile_codes_packed[tile >> 2] >> (uint(tile & 3) * 8u)) & 0xFFu;   // unpack the raw u8 qpmap code
  float weight = weight_lut[code];
  int q = int((float(base_steps[gid]) * weight) + 0.5);
  if (q < 1) {
    q = 1;
  }
  modulated_steps[gid] = q;
}
