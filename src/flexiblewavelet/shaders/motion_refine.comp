#version 450
// motion_refine.comp — spatial-predictor refinement pass (--mv-predict=spatial). Runs AFTER motion_estimate.
// For each block it reads the Pass-1 MVs of the causal neighbours (left/top/top-right) from mv_in, forms the
// H.264 median (the SAME predictor the MV entropy coder pays against), full-searches a small +-SEARCH window
// around it, sub-pel-refines per MOTION_MODE, and writes whichever of {the Pass-1 MV, the best median-region
// MV} has the lower R-D cost = 3-plane SAD + LAMBDA*|mv - spatial_median|. Aligning the ME's rate term with the
// real coder cost makes the chosen MVs cheaper to code. Reads mv_in (a snapshot) and writes mv_out (a separate
// buffer) so the neighbour reads are race-free. Encoder-only: the bitstream and the decoder are unchanged.
layout(local_size_x_id = 1) in;               // workgroup = MB*MB threads, one per block pixel
layout(constant_id = 0) const int MB = 16;
layout(constant_id = 3) const int MOTION_MODE = 3;   // bit0 = 6-tap interpolation (else bilinear), bit1 = quarter-pel MVs (else half-pel)
const int INTERP_6TAP = MOTION_MODE & 1;
const int QUARTER_PEL = (MOTION_MODE >> 1) & 1;
const int MB_SHIFT = (MB == 8) ? 3 : ((MB == 16) ? 4 : 5);
const int MB_MASK = MB - 1;
layout(std430, binding = 0) readonly  buffer Current0  { int current0[]; };
layout(std430, binding = 1) readonly  buffer Current1  { int current1[]; };
layout(std430, binding = 2) readonly  buffer Current2  { int current2[]; };
layout(std430, binding = 3) readonly  buffer Previous0 { int previous0[]; };
layout(std430, binding = 4) readonly  buffer Previous1 { int previous1[]; };
layout(std430, binding = 5) readonly  buffer Previous2 { int previous2[]; };
layout(std430, binding = 6) readonly  buffer MvIn      { int mv_in[]; };    // Pass-1 MVs (snapshot)
layout(std430, binding = 7) writeonly buffer MvOut     { int mv_out[]; };   // refined MVs
layout(push_constant) uniform PushConstants { int width; int height; int blocks_x; int lossless; } push;

const int SEARCH = 4;       // +-4 integer-pel search around the spatial median
const int LAMBDA = 64;      // rate bias against the spatial median (the real coder predictor)

shared int block_current0[MB * MB];
shared int block_current1[MB * MB];
shared int block_current2[MB * MB];
shared int reduce_cost[MB * MB];
shared int reduce_pack[MB * MB];
shared int s_median_x, s_median_y;   // the spatial median MV (MV units), broadcast to all threads
shared int s_mvx, s_mvy;             // the final chosen MV, written by thread 0

int clamp_int(int v, int lo, int hi) { return (v < lo) ? lo : ((v > hi) ? hi : v); }
int decode_current(int raw) { return (push.lossless != 0) ? raw : int(round(intBitsToFloat(raw))); }
int median3(int a, int b, int c) { return (a < b) ? ((b < c) ? b : ((a < c) ? c : a)) : ((a < c) ? a : ((b < c) ? c : b)); }

int previous_plane(int plane, int index) {
  return (plane == 0) ? previous0[index] : ((plane == 1) ? previous1[index] : previous2[index]);
}
int previous_plane_at(int plane, int sample_x, int sample_y) {
  int cx = clamp_int(sample_x, 0, push.width - 1);
  int cy = clamp_int(sample_y, 0, push.height - 1);
  return previous_plane(plane, (cy * push.width) + cx);
}
int tap6(int m2, int m1, int p0, int p1, int p2, int p3) {
  return (((m2 + p3) - (5 * (m1 + p2))) + (20 * (p0 + p1)));
}
int sample_bilinear(int plane, int base_x, int base_y, int half_x, int half_y) {
  if ((half_x == 0) && (half_y == 0)) {
    return previous_plane_at(plane, base_x, base_y);
  }
  if ((half_x == 1) && (half_y == 0)) {
    return (previous_plane_at(plane, base_x, base_y) + previous_plane_at(plane, base_x + 1, base_y) + 1) >> 1;
  }
  if ((half_x == 0) && (half_y == 1)) {
    return (previous_plane_at(plane, base_x, base_y) + previous_plane_at(plane, base_x, base_y + 1) + 1) >> 1;
  }
  return (((previous_plane_at(plane, base_x, base_y) + previous_plane_at(plane, base_x + 1, base_y)) +
           (previous_plane_at(plane, base_x, base_y + 1) + previous_plane_at(plane, base_x + 1, base_y + 1))) + 2) >> 2;
}
int sample_6tap(int plane, int base_x, int base_y, int half_x, int half_y) {
  if ((half_x == 0) && (half_y == 0)) {
    return previous_plane_at(plane, base_x, base_y);
  }
  if ((half_x == 1) && (half_y == 0)) {
    int t = tap6(previous_plane_at(plane, base_x - 2, base_y), previous_plane_at(plane, base_x - 1, base_y),
                 previous_plane_at(plane, base_x,     base_y), previous_plane_at(plane, base_x + 1, base_y),
                 previous_plane_at(plane, base_x + 2, base_y), previous_plane_at(plane, base_x + 3, base_y));
    return (t + 16) >> 5;
  }
  if ((half_x == 0) && (half_y == 1)) {
    int t = tap6(previous_plane_at(plane, base_x, base_y - 2), previous_plane_at(plane, base_x, base_y - 1),
                 previous_plane_at(plane, base_x, base_y),     previous_plane_at(plane, base_x, base_y + 1),
                 previous_plane_at(plane, base_x, base_y + 2), previous_plane_at(plane, base_x, base_y + 3));
    return (t + 16) >> 5;
  }
  int v0 = tap6(previous_plane_at(plane, base_x - 2, base_y - 2), previous_plane_at(plane, base_x - 2, base_y - 1), previous_plane_at(plane, base_x - 2, base_y), previous_plane_at(plane, base_x - 2, base_y + 1), previous_plane_at(plane, base_x - 2, base_y + 2), previous_plane_at(plane, base_x - 2, base_y + 3));
  int v1 = tap6(previous_plane_at(plane, base_x - 1, base_y - 2), previous_plane_at(plane, base_x - 1, base_y - 1), previous_plane_at(plane, base_x - 1, base_y), previous_plane_at(plane, base_x - 1, base_y + 1), previous_plane_at(plane, base_x - 1, base_y + 2), previous_plane_at(plane, base_x - 1, base_y + 3));
  int v2 = tap6(previous_plane_at(plane, base_x,     base_y - 2), previous_plane_at(plane, base_x,     base_y - 1), previous_plane_at(plane, base_x,     base_y), previous_plane_at(plane, base_x,     base_y + 1), previous_plane_at(plane, base_x,     base_y + 2), previous_plane_at(plane, base_x,     base_y + 3));
  int v3 = tap6(previous_plane_at(plane, base_x + 1, base_y - 2), previous_plane_at(plane, base_x + 1, base_y - 1), previous_plane_at(plane, base_x + 1, base_y), previous_plane_at(plane, base_x + 1, base_y + 1), previous_plane_at(plane, base_x + 1, base_y + 2), previous_plane_at(plane, base_x + 1, base_y + 3));
  int v4 = tap6(previous_plane_at(plane, base_x + 2, base_y - 2), previous_plane_at(plane, base_x + 2, base_y - 1), previous_plane_at(plane, base_x + 2, base_y), previous_plane_at(plane, base_x + 2, base_y + 1), previous_plane_at(plane, base_x + 2, base_y + 2), previous_plane_at(plane, base_x + 2, base_y + 3));
  int v5 = tap6(previous_plane_at(plane, base_x + 3, base_y - 2), previous_plane_at(plane, base_x + 3, base_y - 1), previous_plane_at(plane, base_x + 3, base_y), previous_plane_at(plane, base_x + 3, base_y + 1), previous_plane_at(plane, base_x + 3, base_y + 2), previous_plane_at(plane, base_x + 3, base_y + 3));
  int t = tap6(v0, v1, v2, v3, v4, v5);
  return (t + 512) >> 10;
}
int sample_half_pel(int plane, int base_x, int base_y, int half_x, int half_y) {
  return (INTERP_6TAP != 0) ? sample_6tap(plane, base_x, base_y, half_x, half_y) : sample_bilinear(plane, base_x, base_y, half_x, half_y);
}
int half_grid(int plane, int base_x, int base_y, int u, int v) {
  return sample_half_pel(plane, base_x + (u >> 1), base_y + (v >> 1), u & 1, v & 1);
}
int sample_quarter_pel(int plane, int base_x, int base_y, int qx, int qy) {
  int ax = qx & 1, hx = qx >> 1;
  int ay = qy & 1, hy = qy >> 1;
  if ((ax == 0) && (ay == 0)) {
    return half_grid(plane, base_x, base_y, hx, hy);
  }
  if (ay == 0) {
    return (half_grid(plane, base_x, base_y, hx, hy) + half_grid(plane, base_x, base_y, hx + 1, hy) + 1) >> 1;
  }
  if (ax == 0) {
    return (half_grid(plane, base_x, base_y, hx, hy) + half_grid(plane, base_x, base_y, hx, hy + 1) + 1) >> 1;
  }
  return (((half_grid(plane, base_x, base_y, hx, hy) + half_grid(plane, base_x, base_y, hx + 1, hy)) +
           (half_grid(plane, base_x, base_y, hx, hy + 1) + half_grid(plane, base_x, base_y, hx + 1, hy + 1))) + 2) >> 2;
}
int block_current(int plane, int b) {
  return (plane == 0) ? block_current0[b] : ((plane == 1) ? block_current1[b] : block_current2[b]);
}

// 3-plane SAD between the cached current block and the previous frame at integer offset (mv_x, mv_y).
int integer_sad(int origin_x, int origin_y, int mv_x, int mv_y) {
  int sad = 0;
  for (int y = 0; y < MB; y++) {
    int sample_y = clamp_int((origin_y + y) + mv_y, 0, push.height - 1);
    for (int x = 0; x < MB; x++) {
      int sample_x = clamp_int((origin_x + x) + mv_x, 0, push.width - 1);
      int index = (sample_y * push.width) + sample_x, b = (y * MB) + x;
      int d0 = block_current0[b] - previous0[index];
      int d1 = block_current1[b] - previous1[index];
      int d2 = block_current2[b] - previous2[index];
      sad += (((d0 < 0) ? -d0 : d0) + ((d1 < 0) ? -d1 : d1)) + ((d2 < 0) ? -d2 : d2);
    }
  }
  return sad;
}

// 3-plane SAD at a full-precision MV (MV units), sub-pel sampled per MOTION_MODE — for the thread-0 candidates.
int subpel_sad(int origin_x, int origin_y, int mvx, int mvy) {
  int shift = (QUARTER_PEL != 0) ? 2 : 1;
  int sad = 0;
  for (int y = 0; y < MB; y++) {
    for (int x = 0; x < MB; x++) {
      int sample_x = (origin_x + x) + (mvx >> shift), sample_y = (origin_y + y) + (mvy >> shift);
      int b = (y * MB) + x;
      for (int plane = 0; plane < 3; plane++) {
        int pred = (QUARTER_PEL != 0) ? sample_quarter_pel(plane, sample_x, sample_y, mvx & 3, mvy & 3)
                                      : sample_half_pel(plane, sample_x, sample_y, mvx & 1, mvy & 1);
        int d = block_current(plane, b) - pred;
        sad += (d < 0) ? -d : d;
      }
    }
  }
  return sad;
}

// Rate term against the spatial median, normalised toward the SAD (integer-pel) scale.
int rate_cost(int mvx, int mvy) {
  int shift = (QUARTER_PEL != 0) ? 2 : 1;
  return (LAMBDA * ((abs(mvx - s_median_x) + abs(mvy - s_median_y)))) >> shift;
}

void main() {
  int block = int(gl_WorkGroupID.x);
  int block_column = block % push.blocks_x, block_row = block / push.blocks_x;
  int origin_x = block_column * MB, origin_y = block_row * MB;
  uint local_index = gl_LocalInvocationID.x;
  int shift = (QUARTER_PEL != 0) ? 2 : 1;

  // Cache the three current-block planes (plain int for 5/3, a float bit-pattern for 9/7).
  {
    int pixel_x = clamp_int(origin_x + int(local_index & uint(MB_MASK)), 0, push.width - 1);
    int pixel_y = clamp_int(origin_y + int(local_index >> uint(MB_SHIFT)), 0, push.height - 1);
    int index = (pixel_y * push.width) + pixel_x;
    block_current0[local_index] = decode_current(current0[index]);
    block_current1[local_index] = decode_current(current1[index]);
    block_current2[local_index] = decode_current(current2[index]);
  }

  // Thread 0: the H.264 median of the causal neighbours' Pass-1 MVs (the coder's predictor).
  if (local_index == 0u) {
    int bx = block_column, by = block_row;
    int left_x = (bx > 0) ? mv_in[((by * push.blocks_x + (bx - 1)) * 2)] : 0;
    int left_y = (bx > 0) ? mv_in[((by * push.blocks_x + (bx - 1)) * 2) + 1] : 0;
    int up_x = (by > 0) ? mv_in[(((by - 1) * push.blocks_x + bx) * 2)] : 0;
    int up_y = (by > 0) ? mv_in[(((by - 1) * push.blocks_x + bx) * 2) + 1] : 0;
    bool ur = (by > 0) && ((bx + 1) < push.blocks_x);
    int ur_x = ur ? mv_in[(((by - 1) * push.blocks_x + (bx + 1)) * 2)] : 0;
    int ur_y = ur ? mv_in[(((by - 1) * push.blocks_x + (bx + 1)) * 2) + 1] : 0;
    s_median_x = median3(left_x, up_x, ur_x);
    s_median_y = median3(left_y, up_y, ur_y);
  }
  barrier();

  // Parallel integer full-search of +-SEARCH around the median's integer position. Rate is measured against
  // the median (in MV units), so the chosen MV is cheap to code. Default keeps the median itself.
  int center_x = s_median_x >> shift, center_y = s_median_y >> shift;
  int span = (2 * SEARCH) + 1, candidates = span * span;
  int best_cost = 0x7fffffff, best_pack = (64 * 256) + 64;
  for (int c = int(local_index); c < candidates; c += int(gl_WorkGroupSize.x)) {
    int mv_x = center_x + ((c % span) - SEARCH);
    int mv_y = center_y + ((c / span) - SEARCH);
    int cost = integer_sad(origin_x, origin_y, mv_x, mv_y) + rate_cost(mv_x << shift, mv_y << shift);
    if (cost < best_cost) {
      best_cost = cost;
      best_pack = ((mv_x + 64) * 256) + (mv_y + 64);
    }
  }
  reduce_cost[local_index] = best_cost;
  reduce_pack[local_index] = best_pack;
  barrier();
  for (uint stride = gl_WorkGroupSize.x >> 1u; stride > 0u; stride >>= 1u) {
    if (local_index < stride && reduce_cost[local_index + stride] < reduce_cost[local_index]) {
      reduce_cost[local_index] = reduce_cost[local_index + stride];
      reduce_pack[local_index] = reduce_pack[local_index + stride];
    }
    barrier();
  }

  // Thread 0: sub-pel refinement around the integer best (half-pel, then quarter-pel per MOTION_MODE), then a
  // final compare against the untouched Pass-1 MV — both scored with the median rate, so the refine never raises
  // the real coded cost. Write the cheaper to mv_out.
  if (local_index == 0u) {
    int integer_mv_x = (reduce_pack[0] / 256) - 64, integer_mv_y = (reduce_pack[0] % 256) - 64;
    int best_hx = integer_mv_x * 2, best_hy = integer_mv_y * 2;
    int half_best = 0x7fffffff;
    for (int refine_y = -1; refine_y <= 1; refine_y++) {
      for (int refine_x = -1; refine_x <= 1; refine_x++) {
        int hx = (integer_mv_x * 2) + refine_x, hy = (integer_mv_y * 2) + refine_y;
        int mvx = (QUARTER_PEL != 0) ? (hx * 2) : hx, mvy = (QUARTER_PEL != 0) ? (hy * 2) : hy;
        int cost = int(subpel_sad(origin_x, origin_y, mvx, mvy)) + int(rate_cost(mvx, mvy));
        if (cost < half_best) {
          half_best = cost;
          best_hx = hx;
          best_hy = hy;
        }
      }
    }
    int best_mvx = (QUARTER_PEL != 0) ? (best_hx * 2) : best_hx;
    int best_mvy = (QUARTER_PEL != 0) ? (best_hy * 2) : best_hy;
    int best_total = half_best;
    if (QUARTER_PEL != 0) {
      for (int refine_y = -1; refine_y <= 1; refine_y++) {
        for (int refine_x = -1; refine_x <= 1; refine_x++) {
          int qx = (best_hx * 2) + refine_x, qy = (best_hy * 2) + refine_y;
          int cost = int(subpel_sad(origin_x, origin_y, qx, qy)) + int(rate_cost(qx, qy));
          if (cost < best_total) {
            best_total = cost;
            best_mvx = qx;
            best_mvy = qy;
          }
        }
      }
    }
    // The untouched Pass-1 MV, scored with the median rate (guarantees the refine never costs more).
    int pass1_x = mv_in[block * 2], pass1_y = mv_in[(block * 2) + 1];
    int pass1_cost = int(subpel_sad(origin_x, origin_y, pass1_x, pass1_y)) + int(rate_cost(pass1_x, pass1_y));
    if (pass1_cost <= best_total) {
      s_mvx = pass1_x;
      s_mvy = pass1_y;
    } else {
      s_mvx = best_mvx;
      s_mvy = best_mvy;
    }
    mv_out[block * 2] = s_mvx;
    mv_out[(block * 2) + 1] = s_mvy;
  }
}
