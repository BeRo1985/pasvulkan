#version 450
// pthresh.comp — perceptual coefficient thresholding (the fwvperceptualrdo branch, approach B). DECODER-TRANSPARENT:
// it runs on the ENCODER only, BEFORE the normal quantize, and simply ZEROS DWT coefficients whose magnitude is
// below a per-coefficient perceptual threshold. The decoder reconstructs a zero coefficient as zero regardless, so
// no map is transmitted and the decoder / container are untouched. The threshold widens the dead-zone in high-
// activity (texture-masked) regions — small coefficients there are perceptually insignificant, so dropping them
// frees bits for the flat / edge-near regions where artifacts (ringing / banding) are visible. The kept
// coefficients are quantized normally with the canonical step, so the round trip stays exact.
layout(local_size_x = 256) in;
layout(std430, binding = 0)          buffer Coefficients { int coefficients[]; };  // float bit-patterns, modified in place
layout(std430, binding = 1) readonly buffer Thresholds   { int thresholds[];   };  // per-coefficient |coeff| threshold (float bits)
layout(push_constant) uniform PushConstants { int pixel_count; } push;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= uint(push.pixel_count)) {
    return;
  }
  float value = intBitsToFloat(coefficients[i]);
  float threshold = intBitsToFloat(thresholds[i]);
  if (abs(value) < threshold) {
    coefficients[i] = floatBitsToInt(0.0);   // perceptually insignificant in a masked region -> drop
  }
}
