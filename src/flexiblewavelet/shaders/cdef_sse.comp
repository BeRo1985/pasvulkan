#version 450
// cdef_sse.comp — sum of squared differences between two int planes, for the encoder's per-frame CDEF strength
// search: it compares each CDEF-filtered candidate of the reconstructed reference against the ORIGINAL source
// plane and keeps the strength with the lowest SSE. The sum is accumulated into an exact 64-bit counter held as
// two uints (lo + carry), so even a 4K plane of large differences never loses precision. Host reads sse[0..1] and
// forms (uint64)sse[1] << 32 | sse[0]. Reset sse to 0 before each dispatch.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer A   { int a[]; };        // the CDEF-filtered candidate plane
layout(std430, binding = 1) readonly buffer B   { int b[]; };        // the original source plane
layout(std430, binding = 2)          buffer Sse { uint sse[]; };      // sse[0] = low 32 bits, sse[1] = carry (high)
layout(push_constant) uniform PushConstants { int pixel_count; } push;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= uint(push.pixel_count)) {
    return;
  }
  int d = a[i] - b[i];
  uint contribution = uint(d * d);
  uint previous = atomicAdd(sse[0], contribution);
  if ((previous + contribution) < previous) {   // the low word wrapped -> propagate one carry into the high word
    atomicAdd(sse[1], 1u);
  }
}
