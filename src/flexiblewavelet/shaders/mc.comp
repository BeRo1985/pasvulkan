#version 450
// mc.comp — motion compensation with OBMC (overlapped block motion compensation). Each output pixel
// blends the half-pel prediction from its OWN 16x16 block's MV with the predictions from the nearest
// vertical and horizontal neighbour blocks' MVs, weighted by a small edge window (the three weights
// sum to 8). This smooths the blocking that per-block MVs would otherwise leave at block boundaries.
// With mv=0 everywhere all three predictions equal previous, so OBMC is the identity -> colordiff.
layout(local_size_x = 256) in;
layout(constant_id = 0) const int MB = 16;   // motion block size (8 / 16 / 32) — flat per-pixel, the workgroup stays 256
layout(constant_id = 3) const int MOTION_MODE = 3;   // bit0 = 6-tap interpolation (else bilinear), bit1 = quarter-pel MVs (else half-pel)
const int INTERP_6TAP = MOTION_MODE & 1;
const int QUARTER_PEL = (MOTION_MODE >> 1) & 1;
const int MB_SHIFT = (MB == 8) ? 3 : ((MB == 16) ? 4 : 5);   // log2(MB): x / MB -> x >> MB_SHIFT (per-pixel here, so the shift/mask matters)
const int MB_MASK = MB - 1;                                  // x % MB -> x & MB_MASK
layout(std430, binding = 0) readonly  buffer Previous      { int previous[]; };
layout(std430, binding = 1) readonly  buffer MotionVectors { int motion_vectors[]; };   // per block: [mv_x, mv_y] (half-pel)
layout(std430, binding = 2) writeonly buffer McPrevious    { int mc_previous[]; };
layout(push_constant) uniform PushConstants { int width; int height; int blocks_x; } push;

int clamp_int(int value, int low, int high) {
  return (value < low) ? low : ((value > high) ? high : value);
}

// One previous[] sample with replicate-edge coordinate clamping.
int previous_at(int sample_x, int sample_y) {
  int cx = clamp_int(sample_x, 0, push.width - 1);
  int cy = clamp_int(sample_y, 0, push.height - 1);
  return previous[(cy * push.width) + cx];
}

// 6-tap half-pel kernel (H.264 luma weights 1,-5,20,20,-5,1); the half-pel sits between p0 and p1.
int tap6(int m2, int m1, int p0, int p1, int p2, int p3) {
  return (((m2 + p3) - (5 * (m1 + p2))) + (20 * (p0 + p1)));
}

// Bilinear half-pel interpolation of previous[] (the legacy filter, MOTION_MODE bit0 = 0). Old files were
// encoded against this, so it must stay bit-exact to decode them. Deterministic integer rounding.
int sample_bilinear(int base_x, int base_y, int half_x, int half_y) {
  if ((half_x == 0) && (half_y == 0)) {
    return previous_at(base_x, base_y);
  }
  if ((half_x == 1) && (half_y == 0)) {
    return (previous_at(base_x, base_y) + previous_at(base_x + 1, base_y) + 1) >> 1;
  }
  if ((half_x == 0) && (half_y == 1)) {
    return (previous_at(base_x, base_y) + previous_at(base_x, base_y + 1) + 1) >> 1;
  }
  return (((previous_at(base_x, base_y) + previous_at(base_x + 1, base_y)) +
           (previous_at(base_x, base_y + 1) + previous_at(base_x + 1, base_y + 1))) + 2) >> 2;
}

// 6-tap half-pel interpolation of previous[] (MOTION_MODE bit0 = 1). The MV's fractional bits select the
// position: (0,0) integer, (1,0) horizontal half, (0,1) vertical half, (1,1) center = a 6-tap of six
// vertically-6-tapped columns in full precision. All-integer + deterministic rounding so the GPU decode, the
// encoder reconstruction and the CPU reference stay bit-for-bit identical. No value clamp: YCoCg is signed.
int sample_6tap(int base_x, int base_y, int half_x, int half_y) {
  if ((half_x == 0) && (half_y == 0)) {
    return previous_at(base_x, base_y);
  }
  if ((half_x == 1) && (half_y == 0)) {
    int t = tap6(previous_at(base_x - 2, base_y), previous_at(base_x - 1, base_y),
                 previous_at(base_x,     base_y), previous_at(base_x + 1, base_y),
                 previous_at(base_x + 2, base_y), previous_at(base_x + 3, base_y));
    return (t + 16) >> 5;
  }
  if ((half_x == 0) && (half_y == 1)) {
    int t = tap6(previous_at(base_x, base_y - 2), previous_at(base_x, base_y - 1),
                 previous_at(base_x, base_y),     previous_at(base_x, base_y + 1),
                 previous_at(base_x, base_y + 2), previous_at(base_x, base_y + 3));
    return (t + 16) >> 5;
  }
  int v0 = tap6(previous_at(base_x - 2, base_y - 2), previous_at(base_x - 2, base_y - 1), previous_at(base_x - 2, base_y), previous_at(base_x - 2, base_y + 1), previous_at(base_x - 2, base_y + 2), previous_at(base_x - 2, base_y + 3));
  int v1 = tap6(previous_at(base_x - 1, base_y - 2), previous_at(base_x - 1, base_y - 1), previous_at(base_x - 1, base_y), previous_at(base_x - 1, base_y + 1), previous_at(base_x - 1, base_y + 2), previous_at(base_x - 1, base_y + 3));
  int v2 = tap6(previous_at(base_x,     base_y - 2), previous_at(base_x,     base_y - 1), previous_at(base_x,     base_y), previous_at(base_x,     base_y + 1), previous_at(base_x,     base_y + 2), previous_at(base_x,     base_y + 3));
  int v3 = tap6(previous_at(base_x + 1, base_y - 2), previous_at(base_x + 1, base_y - 1), previous_at(base_x + 1, base_y), previous_at(base_x + 1, base_y + 1), previous_at(base_x + 1, base_y + 2), previous_at(base_x + 1, base_y + 3));
  int v4 = tap6(previous_at(base_x + 2, base_y - 2), previous_at(base_x + 2, base_y - 1), previous_at(base_x + 2, base_y), previous_at(base_x + 2, base_y + 1), previous_at(base_x + 2, base_y + 2), previous_at(base_x + 2, base_y + 3));
  int v5 = tap6(previous_at(base_x + 3, base_y - 2), previous_at(base_x + 3, base_y - 1), previous_at(base_x + 3, base_y), previous_at(base_x + 3, base_y + 1), previous_at(base_x + 3, base_y + 2), previous_at(base_x + 3, base_y + 3));
  int t = tap6(v0, v1, v2, v3, v4, v5);
  return (t + 512) >> 10;
}

// Half-pel interpolation; the filter is selected once per stream by the MOTION_MODE spec constant (bit0),
// so the unused branch is compiled out. quarter-pel builds on this, so quarter inherits the chosen filter.
int sample_half_pel(int base_x, int base_y, int half_x, int half_y) {
  return (INTERP_6TAP != 0) ? sample_6tap(base_x, base_y, half_x, half_y) : sample_bilinear(base_x, base_y, half_x, half_y);
}

// Half-pel-grid sample at half-pel units (u, v): u,v in {0,1,2} where 0=integer, 1=half, 2=next integer.
int half_grid(int base_x, int base_y, int u, int v) {
  return sample_half_pel(base_x + (u >> 1), base_y + (v >> 1), u & 1, v & 1);
}

// Quarter-pel interpolation: the quarter position sits exactly at a half-pel-grid point (frac even) or at the
// midpoint between two/four 6-tap half-pel samples (frac odd) -> a rounded average. qx,qy in 0..3 (quarter units).
// Builds on the 6-tap half-pel grid, all-integer + deterministic rounding (matches the CPU reference).
int sample_quarter_pel(int base_x, int base_y, int qx, int qy) {
  int ax = qx & 1, hx = qx >> 1;
  int ay = qy & 1, hy = qy >> 1;
  if ((ax == 0) && (ay == 0)) {
    return half_grid(base_x, base_y, hx, hy);
  }
  if (ay == 0) {
    return (half_grid(base_x, base_y, hx, hy) + half_grid(base_x, base_y, hx + 1, hy) + 1) >> 1;
  }
  if (ax == 0) {
    return (half_grid(base_x, base_y, hx, hy) + half_grid(base_x, base_y, hx, hy + 1) + 1) >> 1;
  }
  return (((half_grid(base_x, base_y, hx, hy) + half_grid(base_x, base_y, hx + 1, hy)) +
           (half_grid(base_x, base_y, hx, hy + 1) + half_grid(base_x, base_y, hx + 1, hy + 1))) + 2) >> 2;
}

int sample_block_mv(int block, int x, int y) {
  int mv_x = motion_vectors[block * 2], mv_y = motion_vectors[(block * 2) + 1];
  if (QUARTER_PEL != 0) {
    return sample_quarter_pel(x + (mv_x >> 2), y + (mv_y >> 2), mv_x & 3, mv_y & 3);
  }
  return sample_half_pel(x + (mv_x >> 1), y + (mv_y >> 1), mv_x & 1, mv_y & 1);
}

// OBMC edge window over an MB-pixel block axis: 2, 1 near each edge, 0 in the middle (MB=16 unchanged).
int edge_weight(int p) {
  return (p < 2) ? 2 : ((p < 4) ? 1 : ((p >= (MB - 2)) ? 2 : ((p >= (MB - 4)) ? 1 : 0)));
}

void main() {
  uint i = gl_GlobalInvocationID.x;
  int pixel_count = push.width * push.height;
  if (i >= uint(pixel_count)) {
    return;
  }
  int x = int(i) % push.width, y = int(i) / push.width;
  int half_block = MB >> 1;
  int blocks_y = ((push.height + MB_MASK)) >> MB_SHIFT;
  int bx = x >> MB_SHIFT, by = y >> MB_SHIFT, px = x & MB_MASK, py = y & MB_MASK;

  int own_block = (by * push.blocks_x) + bx;
  int vertical_block = (clamp_int((py < half_block) ? (by - 1) : (by + 1), 0, blocks_y - 1) * push.blocks_x) + bx;
  int horizontal_block = (by * push.blocks_x) + clamp_int((px < half_block) ? (bx - 1) : (bx + 1), 0, push.blocks_x - 1);

  int vertical_weight = edge_weight(py), horizontal_weight = edge_weight(px);
  int own_weight = (8 - vertical_weight) - horizontal_weight;
  int prediction = sample_block_mv(own_block, x, y) * own_weight;
  if (vertical_weight > 0) {
    prediction += sample_block_mv(vertical_block, x, y) * vertical_weight;
  }
  if (horizontal_weight > 0) {
    prediction += sample_block_mv(horizontal_block, x, y) * horizontal_weight;
  }
  mc_previous[i] = (prediction + 4) >> 3;
}
