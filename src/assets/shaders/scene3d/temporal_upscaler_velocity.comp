#version 450 core

#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable
#extension GL_GOOGLE_include_directive : enable

// The motion vectors as a temporal upscaler gets them: those of the velocity buffer, and for every pixel
// with nothing drawn into it - the sky, the atmosphere, the clouds, the skybox, which all write no velocity -
// the motion of the camera, and where an atmosphere seen from afar dominates the pixel, the motion of that
// atmosphere, see background_velocity.glsl.
//
// The result is written in the convention of the velocity buffer: half the difference of the current and
// the previous position in clip space, each without its jitter.
//
// The temporal antialiasing reads the velocity buffer itself and never this one, but takes the same motion
// for its background from background_velocity.glsl.
//
// With MSAA, the velocity is not the resolved one, which is the average of the samples, but that of the
// nearest sample, the same one the depth resolve takes, see final_depth_resolve.comp. At a silhouette the
// average would be a motion of no surface at all, and the depth and the motion would belong to different
// surfaces.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct View {
  mat4 viewMatrix;
  mat4 projectionMatrix;
  mat4 inverseViewMatrix;
  mat4 inverseProjectionMatrix;
};

layout(set = 0, binding = 0, std140) uniform uboViews {
  View views[256]; // 65536 / (64 * 4) = 256
} uView;

#ifdef MSAA
layout(set = 0, binding = 1) uniform sampler2DMSArray uTextureVelocity;
layout(set = 0, binding = 2) uniform sampler2DMSArray uTextureDepth;
#else
layout(set = 0, binding = 1) uniform sampler2DArray uTextureVelocity;
layout(set = 0, binding = 2) uniform sampler2DArray uTextureDepth;
#endif

layout(set = 0, binding = 3, rg16f) writeonly uniform image2DArray uDestinationTexture;

#define BACKGROUND_VELOCITY_SET 0
#define BACKGROUND_VELOCITY_BINDING 4
#include "background_velocity.glsl"

layout(push_constant) uniform PushConstants {
  uint viewBaseIndex;
  uint countAllViews; // the previous frame's views follow the current ones at this offset
  float farDepth;     // the depth of nothing drawn: 0.0 for the reversed depth, 1.0 for the ordinary one
  uint countSamples;  // the samples per pixel with MSAA
  vec4 jitter;        // xy of this frame, zw of the previous one, as clip space offsets
} pushConstants;

void main(){

  ivec3 at = ivec3(gl_GlobalInvocationID.xyz);

  ivec3 size = imageSize(uDestinationTexture);

  if(any(greaterThanEqual(at, size))){
    return;
  }

  vec2 velocity = texelFetch(uTextureVelocity, at, 0).xy;

  float depth = texelFetch(uTextureDepth, at, 0).x;

#ifdef MSAA
  // Nearest, whichever way the projection runs: with the reversed depth the largest value, with the
  // ordinary one the smallest.
  bool reversedDepth = pushConstants.farDepth == 0.0;
  for(int sampleIndex = 1, countSamples = int(pushConstants.countSamples); sampleIndex < countSamples; sampleIndex++){
    float sampleDepth = texelFetch(uTextureDepth, at, sampleIndex).x;
    if(reversedDepth ? (sampleDepth > depth) : (sampleDepth < depth)){
      depth = sampleDepth;
      velocity = texelFetch(uTextureVelocity, at, sampleIndex).xy;
    }
  }
#endif

  if(depth == pushConstants.farDepth){

    // The pixel centre in clip space, through the jittered projection the frame was rendered with.
    velocity = GetBackgroundVelocity(uView.views[pushConstants.viewBaseIndex + uint(at.z)],
                                     uView.views[pushConstants.viewBaseIndex + uint(at.z) + pushConstants.countAllViews],
                                     fma((vec2(at.xy) + vec2(0.5)) / vec2(size.xy), vec2(2.0), vec2(-1.0)),
                                     pushConstants.farDepth,
                                     pushConstants.jitter);

  }

  imageStore(uDestinationTexture, at, vec4(velocity, 0.0, 0.0));

}
