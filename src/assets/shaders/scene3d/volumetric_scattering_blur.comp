#version 450 core

#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable

// Volumetric scattering, step two: the separable bilateral blur over the half-resolution march, run twice
// - once across, once down - by the direction in the push constants.
//
// It is not a nicety. A handful of steps along a ray cannot give a smooth result on their own, so the
// march scatters the error with a per-pixel jitter instead of leaving it as banding - and that jitter is
// what this pass is here to take back out. Without it the dither shows as a regular grid over the effect.
//
// BOTH buffers go through it together, inscattering and extinction, weighted identically. They describe
// the same air and are put together again by the compose; smoothing one and not the other would leave
// light arriving through air that was never thinned for it.
//
// "Bilateral" is the other half of the point. A plain gaussian would drag a bright shaft across the
// silhouette of whatever is casting it, which reads as a halo around every edge. The gaussian and the
// depth term sit in ONE exponent rather than being multiplied together - a sample that is both far along
// the kernel and at a different distance falls away once, sharply, instead of twice and gently.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2DArray uTextureSourceInscattering;
layout(set = 0, binding = 1) uniform sampler2DArray uTextureSourceExtinction;

// What the march measured, in its own full-float image. The same one for both blur steps and for the
// compose behind them: it is never rewritten, so it cannot drift between stages, and it is not squeezed
// into an alpha where a half float's two-metre steps at four kilometres would look like edges.
layout(set = 0, binding = 4) uniform sampler2DArray uTextureSourceDepth;

layout(set = 0, binding = 2, rgba16f) writeonly uniform image2DArray uDestinationInscatteringTexture;
layout(set = 0, binding = 3, rgba16f) writeonly uniform image2DArray uDestinationExtinctionTexture;

layout(push_constant) uniform PushConstants {
  ivec4 directionSpare; // xy = the step from one tap to the next, in texels; zw unused
} pushConstants;

// How far the blur reaches, and the gaussian falloff over that reach. Four rather than a wider one because
// the march behind it now leaves far less to hide: a kernel wider than the noise it is smoothing turns a
// fine grain into blotches its own size, which read worse than the grain did.
const float KernelRadius = 4.0;
const float BlurSigma = (KernelRadius + 1.0) * 0.5;
const float BlurFallOff = 1.0 / ((2.0 * BlurSigma) * BlurSigma);

// How hard a difference in depth pulls a tap out of the sum. Per unit of linear depth, inside the same
// exponent as the distance along the kernel.
const float DepthFallOff = 0.01;

void main(){

  ivec3 destinationSize = imageSize(uDestinationInscatteringTexture);
  ivec3 at = ivec3(gl_GlobalInvocationID.xyz);

  if(any(greaterThanEqual(at, destinationSize))){
    return;
  }

  ivec2 maximumTexCoord = ivec2(textureSize(uTextureSourceInscattering, 0).xy) - ivec2(1);

  vec4 centerInscattering = texelFetch(uTextureSourceInscattering, at, 0);
  vec4 centerExtinction = texelFetch(uTextureSourceExtinction, at, 0);

  // The centre needs no weight of its own - it cannot disagree with itself - so it goes in at one.
  float centerDepth = texelFetch(uTextureSourceDepth, at, 0).x;

  vec3 sumInscattering = centerInscattering.xyz;
  vec3 sumExtinction = centerExtinction.xyz;
  float sum = 1.0;

  for(int r = 1; r <= int(KernelRadius); r++){

    for(int side = 0; side < 2; side++){

      int offset = (side == 0) ? r : -r;

      ivec2 tapXY = at.xy + (pushConstants.directionSpare.xy * offset);

      // Off the edge is left out rather than clamped: clamping would count the edge texel several times
      // over and pull the result toward it.
      if(((tapXY.x < 0) || (tapXY.x > maximumTexCoord.x)) || ((tapXY.y < 0) || (tapXY.y > maximumTexCoord.y))){
        continue;
      }

      vec4 tapInscattering = texelFetch(uTextureSourceInscattering, ivec3(tapXY, at.z), 0);
      vec4 tapExtinction = texelFetch(uTextureSourceExtinction, ivec3(tapXY, at.z), 0);
      float tapDepth = texelFetch(uTextureSourceDepth, ivec3(tapXY, at.z), 0).x;

      float dz = (tapDepth - centerDepth) * DepthFallOff;
      float weight = exp2((-(float(offset * offset) * BlurFallOff)) - (dz * dz));

      sumInscattering += tapInscattering.xyz * weight;
      sumExtinction += tapExtinction.xyz * weight;
      sum += weight;

    }

  }

  // Nothing to hand the depth on with any more, and nothing to be careful about: it lives in an image of
  // its own that this pass only reads. The second run and the compose read that same image, so the thing
  // the blur is steered by is the same for all of them by construction rather than by being copied
  // correctly at each step.
  imageStore(uDestinationInscatteringTexture, at, vec4(sumInscattering / max(sum, 1e-4), 1.0));
  imageStore(uDestinationExtinctionTexture, at, vec4(sumExtinction / max(sum, 1e-4), 1.0));

}
