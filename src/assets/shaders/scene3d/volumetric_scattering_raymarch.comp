// 460 rather than the 450 the rest of these shaders use, and not for taste: rayQueryEXT and the ray flags
// do not exist below it, however many extensions are enabled. The raytracing build needs one more thing
// besides - "--target-env spirv1.4" on the command line, without which the extension itself is refused -
// and the two together are easy to mistake for a missing extension or a compiler that cannot do it.
#version 460 core

#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable
#extension GL_GOOGLE_include_directive : enable

// Up here rather than beside the ray query that uses them, because an extension directive only counts
// before any code - declared further down it is quietly ignored and the ray flags come back undeclared.
#ifdef RAYTRACING
#extension GL_EXT_ray_tracing : enable
#extension GL_EXT_ray_query : enable
#extension GL_EXT_ray_flags_primitive_culling : enable
#endif

// Volumetric scattering, the first of its three steps: the ray march. It walks the ray from the eye to
// whatever the depth buffer says is in the way and sums up the light scattered into that ray along it -
// the part the atmosphere here cannot do, because its camera volume carries no shadow lookup at all and
// so has no light shafts.
//
// Half resolution, because the result is smooth and the bilateral blur behind it smooths it further.
//
// TWO outputs, not one. Scattered light is not a wash laid over the picture: the same air that adds light
// also takes light away, so what leaves here is what was gathered AND what is left of what was behind it.
// The compose puts them together as inscattering + (extinction * picture), which is the difference
// between air between things and a veil in front of them. The alpha of the first carries the linear view
// depth, which the blur and the compose both need as their edge.
//
// The integration per step is analytic over the whole segment rather than the value at the sample times
// its length:
//
//   inscattering += scattered * ((1 - exp(-extinction * dt)) / extinction) * transmittance
//   transmittance *= exp(-extinction * dt)
//
// which conserves energy however coarsely the ray is walked, and is most of why this needs far fewer
// steps than a plain sum to look the same.
//
// TWO density models, both computed and ADDED, each with a weight of its own:
//
//   RAYLEIGH/MIE - two coefficients and two phase functions over a shell, the model of an atmosphere.
//   NOISE        - one density from an animated noise field with a single Mie phase, which is what suits
//                  a track under a stylised skybox, where there is no atmosphere to be true to.
//
// Added rather than chosen between, because that is what two species of particle in one volume do to a
// ray: each contributes its own scattering and its own extinction, with its own phase already folded in.
// It also makes every arrangement a matter of numbers rather than of a switch - (1,0) is the noise field
// alone, (0,1) the physical model alone, and anything else a genuine mixture.
//
// Both measure their density against the same shell, so height still thins the air in either. And the
// noise field can additionally VARY the physical model's densities without contributing a medium of its
// own - the dust dial - which is a third thing again: not another medium, but the same air in banks.

#include "view.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// SET ONE, and everything of this pass's own with it. Set zero is the scene's global descriptor set, taken
// as it stands, because that is where the acceleration structure lives and where the engine keeps it right
// - see the note at the ray query far below for what went wrong while this pass held a copy of its own.
//
// It costs nothing where there are no rays to cast: the layout is declared either way, and a shader that
// never names a binding of set zero simply does not read one.
layout(set = 1, binding = 0) uniform sampler2DArray uTextureDepth;

layout(std140, set = 1, binding = 1) uniform uboViews {
  View views[256];
} uView;

// rgb = the light scattered into this ray, a = linear view depth for the two steps behind this one.
layout(set = 1, binding = 2, rgba16f) writeonly uniform image2DArray uDestinationInscatteringTexture;

// rgb = what is left of the light coming from behind this ray. Coloured rather than grey, because under
// the Rayleigh/Mie model the air takes the three wavelengths away at different rates - that IS the model.
layout(set = 1, binding = 3, rgba16f) writeonly uniform image2DArray uDestinationExtinctionTexture;

// How far away what this ray ended on is - in its own single-channel FULL-float image, not packed into an
// alpha above. Written here once and read by both blur steps and the compose, so it is never carried from
// stage to stage and the four cannot come to disagree about it.
//
// Full float and not half, because the number is compared against a one-metre threshold. A half float
// holds about five hundredths of a per cent, which at four kilometres is two-metre steps - so two texels
// on the same flat distant surface could differ by more than the threshold allows and be treated as an
// edge between them.
layout(set = 1, binding = 6, r32f) writeonly uniform image2DArray uDestinationDepthTexture;

#ifdef VOLUMETRIC_SCATTERING_DUAL_OUTPUT
// The same two quantities again, for a ray that does NOT stop at the geometry: what the air does over the
// sky's distance at this pixel.
//
// Why a second answer is needed at all. At a silhouette the resolved depth names the nearest sample - it
// has to, "is any part of this pixel in front" being the right question for an occlusion test - so the
// march walks to the geometry, and the air over the sky standing behind it is computed by nobody. The
// compose then hands that sky the geometry's air, and that is the rim along every outline. Compositing per
// sample does not reach it: each sample gets its own colour and its own depth, but they all read the same
// marched air. Measured, both ways - the rim survives per-sample compositing, and it survives a size
// divisor of one.
//
// Borrowing the value from a neighbouring sky texel was built and measured too, and it is the honest
// second best: it does remove the rim, but WHICH neighbour is nearest changes as the camera moves and the
// answer jumps with it. Switching that search off put the rim back and took the flicker with it, which is
// what settled the question.
//
// So it is computed rather than borrowed: one march, two results, read off at two points of the same ray.
layout(set = 1, binding = 7, rgba16f) writeonly uniform image2DArray uDestinationFarInscatteringTexture;
layout(set = 1, binding = 8, rgba16f) writeonly uniform image2DArray uDestinationFarExtinctionTexture;
#endif

layout(push_constant) uniform PushConstants {

  // ONE hundred and twenty-eight bytes, exactly, and that is not a coincidence to be spent: it is the
  // smallest maxPushConstantsSize Vulkan guarantees and the figure AMD drivers commonly report. Eight
  // vectors is therefore the whole budget - a ninth would be refused on hardware this has to run on.
  //
  // Laid out so that the floats are grouped by what they describe and everything that had to be squeezed
  // sits together in ONE word at the end, rather than hiding in the spare lane of whatever vector happened
  // to have room. A field named for one thing that quietly carries another is how this block became hard
  // to read in the first place.

  // xyz = the direction the sunlight travels, w = the shaft gain.
  //
  // That w is a CHEAT and the name says so. It scales the gathered light alone, which no medium can do:
  // for a scattering medium, more light sent toward the eye means more taken from what lies behind, and
  // that half belongs to the mean free path. Unreal, Unity and CryEngine all carry the same dial under
  // their own names.
  //
  // What it is a gain ON is the radiance below, which is the real thing. That distinction is the whole
  // difference between this and what it was: a gain that multiplies nothing is not a gain, it is the only
  // brightness there is, and the shafts then stay exactly as bright while the sun sets.
  //
  // It is NOT the factor the game turns the whole effect down by - that one belongs to the compose alone,
  // which has to pull the extinction back toward one by the same amount and cannot do that from here.
  // Applied in both places, as it once was, it would count twice and a half would come out a quarter.
  vec4 sunDirectionShaftGain;

  // xyz = what the primary directional light actually emits, colour times intensity, in the same units the
  // surface shading is given. Kept apart from the gain above rather than folded into it on the way here,
  // so that a capture shows the two separately: one is the scene, the other is the lie told about it.
  //
  // w = the mean free path of the PHYSICAL model, in metres: how far light travels in this air before it
  // is scattered once. The one dial that model has, and the artist-facing form of a density - Unity's HDRP
  // asks for the same quantity by the same name.
  vec4 sunRadianceMeanFreePath;

  // x = the near distance, which turns a raw depth back into metres. NEGATIVE in this engine, which marks
  // a reversed infinite projection, so every reader has to take its magnitude - a trap both this pass and
  // the compose fell into once.
  //
  // y = how far a ray with nothing in its way is marched, and the distance the result is faded in over.
  // The MARCH's reach and not a far plane: geometry stands further away than this all the time.
  //
  // zw = what the noise model scatters and what it swallows, per unit of its density. Only that model
  // reads them; the physical one has Earth's own coefficients, which are constants and not knobs.
  vec4 zNearMaximumDistanceNoiseCoefficients;

  // xyz = the centre of the shell the density is measured against, w = its bottom radius. Between them
  // they turn a world position into a height, which is what makes the air thin as one climbs - and it is
  // all either model asks of the shell, so neither needs an atmosphere to exist.
  //
  // The shell's TOP radius is deliberately not here. Nothing ever read it.
  vec4 shellCentreBottomRadius;

  // x = the Rayleigh scale height, y = the Mie one: how fast each of the two thins with altitude.
  //
  // z = how coarse the noise field is.
  //
  // w = the time the field moves with, so that standing still does not mean standing in a fixed pattern.
  // Already taken modulo noiseDriftCycle by the pass, and that is a contract and not a convenience: the
  // field's octaves each advance by a whole number of lattice periods over exactly one cycle, so a clock
  // wrapped at the same cycle comes back around without anything moving. Hand it an unwrapped one and the
  // pattern falls apart in the low bits instead.
  vec4 scaleHeightsNoiseScaleTime;

  // x = how much the aerial term weighs - what the distance adds over and above the march, and takes away
  // with it.
  //
  // y = the depth the sky is given. A SENTINEL and not a distance: under a reversed infinite projection a
  // sky pixel has no finite distance to compute, so this pass and the compose agree on one number instead
  // of both clamping the same division and hoping to land on the same result.
  //
  // z = how thick the noise field is made. Its own dial, and NOT its share of the mixture - that is a
  // separate number below, because a normalised share keeps only a ratio and would discard an amount
  // folded into it exactly when that model runs alone.
  //
  // w = spare. The only whole float left in the block.
  vec4 aerialWeightSkyDepthNoiseDensitySpare;

  // x = the first view this pass renders, y = the frame counter the jitter is rotated by.
  //
  // z = the switches, in a word of their own rather than squeezed into a float's spare lane.
  //
  // w = the step counts, fewest in the low sixteen bits and most in the high sixteen. They are small
  // whole numbers - the march is capped at 256 steps - so a word holds both with room over.
  uvec4 viewBaseIndexFrameIndexFlagsStepCounts;

  // Everything too small to be worth a lane of its own, in one place so that it can be found:
  //
  //   x = the tint's red and green, two halves
  //   y = the tint's blue in the low half; the high half is spare
  //   z = the two models' SHARES of the mixture - Rayleigh/Mie low, noise field high
  //   w = how hard the noise field varies the physical model's densities - the dust - Mie low, Rayleigh
  //       high. Two of them because dust is Mie and not Rayleigh: large particles clump and throw light
  //       forward, molecular air does neither.
  //
  // Half precision throughout, which is ample for what these are: multipliers around one and shares
  // between nought and one, none of them a measured quantity.
  uvec4 packedTintSharesDust;

} pushConstants;

// Bit zero is free. It used to pick between two segment lengths - the ray's own and the distance out of
// the atmosphere - which turned out to be a statement about how thick the air is, written as a length. It
// is now the mean free path in the push constants, where it can be read as the distance it always was.

// Bit one is free as well. It used to pick between the two density models, one or the other. They are now
// both computed and added, each with a weight of its own, so the question it answered no longer has two
// answers: the noise field alone is (1,0), Rayleigh/Mie alone is (0,1), and everything between is a real
// mixture rather than a choice.

// The look this effect had before it grew a second buffer: the gathered light faded in with the square of
// the distance and then capped at a quarter however bright it came out, no aerial term, and nothing taken
// away from the picture at all. The cap is the substance of it - without it the march adds around 1.8 to
// an HDR picture where the old one added at most 0.27, which is the difference between light shafts and a
// sheet of haze with the world faintly behind it.
const uint VolumetricScatteringFlagLegacyLook = 1u << 2;

#include "math.glsl"

#define SHADOWS
#define NOTEXCOORDS
#define NUM_SHADOW_CASCADES 4
#define inFrameIndex pushConstants.viewBaseIndexFrameIndexFlagsStepCounts.y
#define SHADOWS_SCREEN_POSITION vec2(gl_GlobalInvocationID.xy)

const uint SHADOWMAP_MODE_NONE = 1;
const uint SHADOWMAP_MODE_PCF = 2;
const uint SHADOWMAP_MODE_DPCF = 3;
const uint SHADOWMAP_MODE_PCSS = 4;
const uint SHADOWMAP_MODE_MSM = 5;

// In set 1 with the rest of this pass's own, rather than in the set 3 the other shadow readers use: those
// share a pipeline layout with the atmosphere, and this pass has one of its own - the scene's global set
// followed by this one, with nothing in between to declare.
layout(set = 1, binding = 4, std140) uniform uboCascadedShadowMaps {
  mat4 shadowMapMatrices[NUM_SHADOW_CASCADES];
  vec4 shadowMapSplitDepthsScales[NUM_SHADOW_CASCADES];
  vec4 constantBiasNormalBiasSlopeBiasClamp[NUM_SHADOW_CASCADES];
  uvec4 metaData; // x = type
} uCascadedShadowMaps;

layout(set = 1, binding = 5) uniform sampler2DArray uCascadedShadowMapTexture;

// Both views of the one binding, always - not behind a define as elsewhere. Which of the four modes runs
// is a run-time switch, so shadows.glsl compiles the PCF case whatever the mode is, and that case names
// the comparison sampler. Declaring only one of the two therefore does not build at all; declaring both
// costs nothing where the mode never reaches them.
//
// Yay! Binding Aliasing! :-)
layout(set = 1, binding = 5) uniform sampler2DArrayShadow uCascadedShadowMapTextureShadow;

// What shadows.glsl reads out of its includer. lightDirection is the direction the light TRAVELS, which is
// what the functions in there expect to be handed the negation of.
vec3 inWorldSpacePosition, workNormal, lightDirection;

#include "shadows.glsl"

#ifdef RAYTRACING

// The acceleration structure, at the place the ENGINE keeps it: set 0, binding 8 of the scene's global
// descriptor set, which is why this pass's own bindings were moved out to set 1.
//
// It used to be declared as a binding of this pass's own, with the pass writing it into its own descriptor
// set whenever the handle or the generation changed. That looked equivalent and was not. The structure is
// per-in-flight-frame state and double-buffered besides:
//
//   TDoubleBufferedTopLevelAccelerationStructures = array[0..1] of ...
//   TTopLevelAccelerationStructures = array[-1..MaxInFlightFrames-1] of TVkAccelerationStructureKHR
//
// and the scene builds this frame's one in UpdateRaytracing before writing it to the global set. A copy
// kept elsewhere reads whichever structure happens to be current when the pass records, which is not
// necessarily the one belonging to this frame. Rays then miss everything, every sample reads as lit, and
// the march fills the volume with an even haze - barely noticeable under open sky, and inside a tunnel it
// swallows the whole picture.
//
// Every other raytracing consumer in this engine reads it from the global set. This one does now too, and
// the whole class of fault goes with it.
//
// The ray query is still written out rather than calling raytracing.glsl's getRaytracedFastHardShadow -
// that would pull in the instance data, the mesh buffers and the octahedral maps for five lines. The flags
// and the cull mask below are that function's, exactly. What is deliberately left out is its offset along
// a surface normal: that keeps a surface from shadowing itself, and a point in mid-air has no surface.
//
// The two extension directives this needs are at the top of the file, where they have to be.
layout(set = 0, binding = 8) uniform accelerationStructureEXT uRaytracingTopLevelAccelerationStructure;

// The same cull mask the rest of the engine casts shadow rays with, so this sees exactly what the shadow
// maps see.
#define CULLMASK_SHADOWS 0x01

#endif // RAYTRACING

// The Mie phase's mean cosine for the noise model, and the coefficients of the Rayleigh/Mie one at sea
// level. The latter are left in the units they are defined in, because the world here is in metres too -
// the track's own sample spacing says so - so nothing about them needs converting.
const float noiseModelG = 0.9;
const float atmosphereModelG = 0.76;
const vec3 bM = vec3(21e-6);
const vec3 bR = vec3(5.8e-6, 13.5e-6, 33.1e-6);

// The aerial term at the very end: what the distance itself adds, over and above anything the march
// gathered. Its colour is a look rather than a measurement; its weight is a push constant, because on a
// scene that already has a fog pass of its own this is a second haze on top of a first, and whether that
// is wanted is not something this shader can know. Zero switches it off outright.
const vec3 aerialColour = vec3(0.4, 0.65, 1.0);

// (x:5,y:5)-offseted bayer's optimum 8x8 index matrix (1973). Every pixel starts its walk at a slightly
// different point between two steps, so that the samples read as a smear rather than as bands.
const float gJitterOffsets[64] = float[](
  0.265625, 0.703125, 0.453125, 0.531250, 0.281250, 0.718750, 0.468750, 0.515625,
  0.890625, 0.078125, 0.828125, 0.156250, 0.906250, 0.093750, 0.843750, 0.140625,
  0.390625, 0.578125, 0.328125, 0.656250, 0.406250, 0.593750, 0.343750, 0.640625,
  0.796875, 0.234375, 0.984375, 0.000000, 0.750000, 0.187500, 0.937500, 0.046875,
  0.296875, 0.734375, 0.484375, 0.500000, 0.250000, 0.687500, 0.437500, 0.546875,
  0.921875, 0.109375, 0.859375, 0.125000, 0.875000, 0.062500, 0.812500, 0.171875,
  0.421875, 0.609375, 0.359375, 0.625000, 0.375000, 0.562500, 0.312500, 0.671875,
  0.765625, 0.203125, 0.953125, 0.031250, 0.781250, 0.218750, 0.968750, 0.015625
);

// How far the field repeats, in lattice cells, and how long the whole movement takes to come back to where
// it started, in seconds. The two together are what let the drift below WRAP instead of jump.
//
// The lattice REPEATS: a whole number of periods added to a position is not a similar field, it is the
// same field to the last bit. Every layer velocity below advances by a whole number of periods over
// exactly one cycle, and the pass hands the clock over modulo that same cycle - so at the moment the clock
// comes back around, every layer stands exactly where it stood and nothing on screen moves.
//
// Without the repetition there is nothing to wrap against and the clock has to be let run instead, which
// is what the old arrangement did: a float counting seconds since the race started loses the low bits the
// pattern is made of, and there is no length of time at which it can be reset without the field changing
// under the eye. This is the same question answered from the other end.
//
// Both are powers of two, so neither the modulo nor the offsets lose anything to rounding.
//
// The PERIOD is chosen against the march and not against the eye: five hundred and twelve cells is 5120
// metres at the default noise scale, and the march reaches 4096. The repeat therefore cannot fall inside
// one ray however the camera is pointed, which is the only place it could have been seen at all. That
// margin is worth insisting on, because the field a period away is not faintly similar but three quarters
// correlated - the first octave carries half the amplitude and repeats exactly. At 256 the repeat would
// have sat well inside the march. It costs nothing: the modulo is the same instruction either way.
//
// The CYCLE is then chosen against the period, to keep the quantum where it was: a thirty-second of a cell
// per second is fine enough for the slowest layer to be slow. Four and a half hours is longer than any
// session, and a float still resolves two thousandths of a second at the far end of it - the better part
// of ten times finer than a frame, so the movement does not go stepwise as the cycle runs out.
const float noiseLatticePeriod = 512.0;
const float noiseDriftCycle = 16384.0;

// What one lattice period per cycle comes to, in cells per second. Every velocity below is a whole
// multiple of it in each of its three components, and that is the entire price of the seamless wrap.
const float noiseDriftQuantum = noiseLatticePeriod / noiseDriftCycle;

// A movement of its own for each octave, and that is the whole point of the arrangement. Moving the field
// as one body is a slide and nothing more: the shapes stay rigid and only their position changes, which
// from a standing craft reads as a wall of mist being pushed past rather than as air. Layers that move
// against one another cross and uncross, so the shapes are made and unmade where they stand - the field
// boils instead of travelling, and it goes on boiling for somebody who is not moving at all.
//
// They share a bias along +x so that there is still a wind in it, and differ enough beside that bias for
// the crossing to happen at all. The finer octaves are the faster ones: small structure turns over quickly
// and large structure does not, which is what turbulence does at every scale one cares to look at.
//
// In noise space and not in metres, so the rate holds whatever VolumetricScatteringNoiseScale is set to. A
// field made finer then boils at the same speed relative to its own features instead of racing - which the
// old world-space drift did not do, being a velocity in metres applied before the scale was.
const vec3 noiseLayerVelocities[4] = vec3[4](vec3(2.0, 1.0,  1.0) * noiseDriftQuantum,
                                             vec3(3.0, 3.0, -1.0) * noiseDriftQuantum,
                                             vec3(5.0, 1.0,  4.0) * noiseDriftQuantum,
                                             vec3(7.0, 4.0, -2.0) * noiseDriftQuantum);

// Where one octave stands at a given time, folded back into a single lattice period. The fold changes
// nothing about what is sampled - the lattice repeats, so it is the same field either way - and it keeps
// the position handed to the noise small, which is what keeps the sub-cell precision the pattern needs.
vec3 noiseLayerOffset(const in int aLayer, const in float aTime){
  return mod(noiseLayerVelocities[aLayer] * aTime, noiseLatticePeriod);
}

// The noise field the second density model is built from: value noise, three octaves and a bit, over a
// rotating basis so the octaves do not line up into a grid.
//
// ONE channel and not three. The density is a scalar and always was, so the three-channel form computed
// two numbers at each of the eight lattice corners of each of the four octaves of every march step and
// then threw them away at the call site. What comes out here is bit for bit that form's x, and the work
// saved is what pays for the wrapping the corners now do.
float hash13(vec3 p){
  vec3 p3 = fract(p.xyz * vec3(0.1031, 0.1030, 0.0973));
  p3 += dot(p3, p3.yxz + 19.19);
  return fract((p3.x + p3.y) * p3.z);
}

// The CORNER is wrapped and not the position: the interpolation across the last cell then runs between it
// and the first one, so the lattice closes on itself with nothing to see at the join. Wrapping the
// position instead would fold the interpolant with it and put a hard edge there.
float noise13(in vec3 p){
  vec3 f = fract(p);
  vec3 i0 = mod(floor(p), noiseLatticePeriod);
  vec3 i1 = mod(i0 + 1.0, noiseLatticePeriod);
  f = (f * f) * (3.0 - (2.0 * f));
  return mix(mix(mix(hash13(vec3(i0.x, i0.y, i0.z)), hash13(vec3(i1.x, i0.y, i0.z)), f.x),
                 mix(hash13(vec3(i0.x, i1.y, i0.z)), hash13(vec3(i1.x, i1.y, i0.z)), f.x), f.y),
             mix(mix(hash13(vec3(i0.x, i0.y, i1.z)), hash13(vec3(i1.x, i0.y, i1.z)), f.x),
                 mix(hash13(vec3(i0.x, i1.y, i1.z)), hash13(vec3(i1.x, i1.y, i1.z)), f.x), f.y), f.z);
}

// The octave's offset is added AFTER the rotation, so it is a movement in that octave's own frame rather
// than one shared movement seen through four different rotations - which would be a slide again, only a
// slide whose direction the basis had turned.
float fbm13(vec3 p, const in float aTime){
  const mat3 m = mat3( 0.00,  0.80,  0.60,
                      -0.80,  0.36, -0.48,
                      -0.60, -0.48,  0.64);
  float r = 0.5000 * noise13(p + noiseLayerOffset(0, aTime)); p = (m * p) * 2.03;
  r += 0.2500 * noise13(p + noiseLayerOffset(1, aTime)); p = (m * p) * 2.02;
  r += 0.1250 * noise13(p + noiseLayerOffset(2, aTime)); p = (m * p) * 2.01;
  r += 0.0625 * noise13(p + noiseLayerOffset(3, aTime));
  return r / 0.9375;
}

// How thin the air is where this sample sits, measured against the shell. Both models use it: the one as
// its Rayleigh and Mie densities, the other as what the noise field is multiplied by, so that height
// thins the fog whichever is chosen.
void computeShellDensities(const in vec3 aPosition, out float aRayleigh, out float aMie){
  float height = length(aPosition - pushConstants.shellCentreBottomRadius.xyz) - pushConstants.shellCentreBottomRadius.w;
  aRayleigh = exp(-(max(height, 0.0) / pushConstants.scaleHeightsNoiseScaleTime.x));
  aMie = exp(-(max(height, 0.0) / pushConstants.scaleHeightsNoiseScaleTime.y));
}

// How far this ray runs before it leaves a sphere of the given radius about the shell's centre.
float computeEscapeLength(const in vec3 aPosition, const in vec3 aDirection, const in float aRadius){
  vec3 v = aPosition - pushConstants.shellCentreBottomRadius.xyz;
  float b = dot(v, aDirection);
  float c = dot(v, v) - (aRadius * aRadius);
  float det = (b * b) - c;
  if(det < 0.0){
    return -1.0;
  }else{
    det = sqrt(det);
    float t1 = (-b) - det;
    float t2 = (-b) + det;
    return (t1 >= 0.0) ? t1 : t2;
  }
}

// How much of the light reaches this point in the volume. The cascade walk is the one getFastCascadedShadow
// does, written out here rather than called, because that one carries a receiver-plane bias prologue meant
// for a surface and a raytracing branch of its own; RAYTRACING is handled below in its place.
//
// workNormal is the piece a volume does not have. Setting it to the direction the light comes FROM makes
// the normal-bias term degenerate - dot(N,L) is one, so both the normal and the slope offset fall to zero
// and only the constant bias is left. That is the honest answer for a point that has no surface.
float sampleShadow(const in vec3 aWorldPosition, const in float aMaximumDistance){

  inWorldSpacePosition = aWorldPosition;
  workNormal = -lightDirection;

#if defined(RAYTRACING)

  // Opaque triangles only, stopping at the first one: whether anything at all stands between this point
  // and the light is the whole question, and nothing about which thing it was matters here.
  const uint rayFlags = gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsCullNoOpaqueEXT | gl_RayFlagsSkipAABBEXT;

  // How far the ray looks for something in the way - and NOT aMaximumDistance, which is the length of the
  // VIEW ray this sample sits on. The two have nothing to do with each other: how far the camera happens to
  // see past this point says nothing about how far away the thing shading it is.
  //
  // Passing the view length was the fault, and it hid well because the cascade branch below ignores the
  // parameter entirely - so the two shadow paths disagreed only here. A sample deep inside a tunnel, where
  // the view ray is a few tens of metres, got a shadow ray that gave up before reaching anything, came back
  // unshadowed, and the march then filled the tunnel with evenly lit haze. Under open sky the same fault
  // costs almost nothing, and at Earth density it is invisible - which is why it only ever showed with the
  // atmosphere-distance segments, the mode that is some two hundred times brighter.
  //
  // The effect's own maximum distance instead: the same reach the march itself is given.
  float shadowRayReach = pushConstants.zNearMaximumDistanceNoiseCoefficients.y;

  rayQueryEXT rayQuery;
  rayQueryInitializeEXT(rayQuery,
                        uRaytracingTopLevelAccelerationStructure,
                        rayFlags,
                        CULLMASK_SHADOWS,
                        aWorldPosition,
                        0.0,
                        normalize(-lightDirection),
                        shadowRayReach);
  rayQueryProceedEXT(rayQuery);
  float raytracedShadow = (rayQueryGetIntersectionTypeEXT(rayQuery, true) == gl_RayQueryCommittedIntersectionTriangleEXT) ? 0.0 : 1.0;
  rayQueryTerminateEXT(rayQuery);

  return raytracedShadow;

#else

  vec3 shadowUVW;
  float shadow = -1.0;

  int cascadedShadowMapIndex = 0;
  while(cascadedShadowMapIndex < NUM_SHADOW_CASCADES){
    shadow = doCascadedShadowMapShadow(cascadedShadowMapIndex, -lightDirection, shadowUVW);
    if(shadow < 0.0){
      cascadedShadowMapIndex++;
    }else{
      break;
    }
  }

  // Past the last cascade there is nothing to ask, and a sample nobody can answer for counts as lit: the
  // alternative would be a wall of shadow at the cascade edge.
  return (shadow < 0.0) ? 1.0 : clamp(shadow, 0.0, 1.0);

#endif

}

// What one segment of the ray adds, integrated over the whole of it rather than taken at its sample point.
// Guarded against an extinction of nothing, where the closed form is a division by zero and the answer is
// simply the segment's length.
vec3 segmentIntegral(const in vec3 aExtinctionCoefficient, const in float aSegmentLength){
  vec3 e = max(aExtinctionCoefficient, vec3(1e-10));
  return (vec3(1.0) - exp(-(e * aSegmentLength))) / e;
}

void main(){

  ivec3 destinationSize = imageSize(uDestinationInscatteringTexture);
  ivec3 at = ivec3(gl_GlobalInvocationID.xyz);

  if(any(greaterThanEqual(at, destinationSize))){
    return;
  }

  uint viewIndex = pushConstants.viewBaseIndexFrameIndexFlagsStepCounts.x + uint(at.z);
  mat4 projectionMatrix = uView.views[viewIndex].projectionMatrix;
  mat4 inverseViewMatrix = uView.views[viewIndex].inverseViewMatrix;
  mat4 inverseProjectionMatrix = uView.views[viewIndex].inverseProjectionMatrix;

  // The depth is at FULL resolution and this march is at half, so the invocation is not a texel of it: the
  // two have to be mapped through their sizes. Fetching at `at` reads the top left quarter of the depth
  // buffer and stretches it over the whole picture - every ray then stops where something stands somewhere
  // else entirely, which looks like shadows without casters and like the whole effect being offset.
  //
  // Through the ratio rather than a fixed two, because half of an odd width is not half.
  ivec2 depthSize = ivec2(textureSize(uTextureDepth, 0).xy);
  ivec2 depthAt = clamp(ivec2((vec2(at.xy) + vec2(0.5)) * (vec2(depthSize) / vec2(destinationSize.xy))),
                        ivec2(0),
                        depthSize - ivec2(1));

  float rawDepth = texelFetch(uTextureDepth, ivec3(depthAt, at.z), 0).x;

  // The ray, from the near plane to whatever stands in the way. Reconstructed through the inverse
  // projection first and then out of view space, which is the same route fog.frag takes - going straight
  // through one combined inverse loses precision where it is needed most, far away.
  vec2 texCoord = (vec2(at.xy) + vec2(0.5)) / vec2(destinationSize.xy);
  vec2 clipSpaceCoord = (texCoord * 2.0) - vec2(1.0);

  // Which way round the depth runs, read off the projection itself the way fog.frag reads it. This has to
  // be known BEFORE the near plane is unprojected: under reversed Z the near plane is at one and the FAR
  // plane is at zero, and unprojecting zero as if it were the near plane asks for a point at infinity on
  // an infinite projection - w goes to nothing and the whole march runs in empty space.
  bool reversedZ = projectionMatrix[2][3] < -1e-7;
  bool hasGeometry = reversedZ ? (rawDepth > 0.0) : (rawDepth < 1.0);

  vec4 nearView = inverseProjectionMatrix * vec4(clipSpaceCoord, reversedZ ? 1.0 : 0.0, 1.0);
  vec3 startPosition = (inverseViewMatrix * vec4(nearView.xyz / nearView.w, 1.0)).xyz;

  // The eye, for the direction of a ray that has nothing to aim at. On a perspective projection the near
  // plane point minus the eye IS the ray direction, so this needs no second unprojection.
  vec3 eyePosition = inverseViewMatrix[3].xyz;
  vec3 rayDirection = startPosition - eyePosition;
  float rayDirectionLength = length(rayDirection);
  if(rayDirectionLength < 1e-8){
    imageStore(uDestinationInscatteringTexture, at, vec4(0.0));
    imageStore(uDestinationExtinctionTexture, at, vec4(1.0));
    imageStore(uDestinationDepthTexture, at, vec4(pushConstants.aerialWeightSkyDepthNoiseDensitySpare.y));
    return;
  }
  rayDirection /= rayDirectionLength;

  // Both start at the far end a ray without geometry is given, and are only replaced where there is
  // something to replace them with.
  //
  // The depth is NOT the view-space distance of the end point, which would be the obvious thing to write
  // here. It is zNear over the raw value instead, because that is what the compose behind this computes
  // from the full-resolution depth to weigh its taps against - and two quantities that are compared with
  // each other have to be the same quantity.
  //
  // And the length is capped at the same far end even where there IS geometry: a handful of steps spread
  // over a ten kilometre ray are steps a kilometre apart, which is not a march. The cap costs the far end
  // of such a ray and keeps the near end worth having.
  float rayLength = pushConstants.zNearMaximumDistanceNoiseCoefficients.y;

  // The sky's depth is the STORE CAP, not the march's reach - those are two different numbers and confusing
  // them is what put a seam along every silhouette. The march reaches 4096 metres; the depth written here
  // has to be a value no real distance can collide with, because the compose has to be able to tell "this
  // pixel is sky" from "this pixel is a mountain twelve kilometres away". Under a reversed infinite
  // projection there is no far plane to borrow such a value from, so it comes from the buffer format
  // instead - see the note on the cap in the push constants.
  float linearViewDepth = pushConstants.aerialWeightSkyDepthNoiseDensitySpare.y;

  // Sky is NOT skipped here, unlike in the fog: a light shaft is at its most visible against it, and a ray
  // with nothing in its way is exactly the one that should be allowed to gather light for its whole
  // length. What it must not do is march to the far plane - the projection is an infinite one, so the
  // reconstruction there divides by a w of zero and hands back infinities, which is how a NaN gets into
  // the buffer and comes out of the compose as blocks of nothing. So such a ray gets a finite end
  // instead, and the reconstruction is only trusted where it can be.
  if(hasGeometry){
    vec4 farView = inverseProjectionMatrix * vec4(clipSpaceCoord, rawDepth, 1.0);
    vec3 farViewPosition = farView.xyz / farView.w;
    if(!(any(isinf(farViewPosition)) || any(isnan(farViewPosition)))){
      vec3 endPosition = (inverseViewMatrix * vec4(farViewPosition, 1.0)).xyz;
      rayLength = min(length(endPosition - startPosition), pushConstants.zNearMaximumDistanceNoiseCoefficients.y);
      // The true distance, bounded only by the store cap. Not by the march's reach: geometry stands
      // further away than 4096 metres all the time, and clamping there would file every distant thing
      // under the same depth as the sky - which is precisely what the upsample must be able to tell apart
      // at a skyline.
      //
      // The near distance goes in as a MAGNITUDE. In this engine a reversed infinite projection is marked
      // by a negative near plane and an infinite negative far, so zNear arrives as something like -0.01 -
      // and dividing by it hands back negative distances, which then compare against the positive value
      // the sky is given as though they were the same kind of number. This is the same trap the compose
      // fell into, and both sides have to take the magnitude or neither reading means anything.
      //
      // Held to half the sky's value: the division is open at the top, and a raw depth close enough to
      // zero would otherwise produce something that collides with the sky's own number - which is the one
      // thing this depth exists to be distinguishable from.
      //
      // The sky never reaches this line at all: it keeps the value it was initialised with, because
      // hasGeometry is false for a raw depth of zero.
      linearViewDepth = min(abs(pushConstants.zNearMaximumDistanceNoiseCoefficients.x) / max(rawDepth, 1e-7),
                            pushConstants.aerialWeightSkyDepthNoiseDensitySpare.y * 0.5);
    }
  }

  lightDirection = pushConstants.sunDirectionShaftGain.xyz;

  bool legacyLook = (pushConstants.viewBaseIndexFrameIndexFlagsStepCounts.z & VolumetricScatteringFlagLegacyLook) != 0u;

  // How hard the noise field varies the Rayleigh/Mie densities. Unpacked once out here rather than per
  // step: it is the same for the whole ray, and the physical branch is walked a couple of hundred times.
  //
  // The Mie one first, because that is the dust: large particles gather into banks and throw light
  // forward. Rayleigh is molecular air and does neither, so its factor is normally left at zero and the
  // sky stays as evenly blue as the model says it should be.
  vec2 noiseModulation = unpackHalf2x16(pushConstants.packedTintSharesDust.w);
  bool noiseModulated = (noiseModulation.x + noiseModulation.y) > 0.0;

  // How much of each medium is in the air. Both models are computed and ADDED rather than one of them
  // chosen, which is what two species of particle in one volume actually do to a ray - and it is what
  // makes every arrangement reachable by numbers instead of by a switch: (1,0) is the noise field alone,
  // (0,1) the physical model alone, anything else a mixture.
  //
  // Divided by their SUM, so the two weights always come to one and the total amount of medium holds
  // however they are set against each other. Half and half is half of each - the pair says what the air is
  // MADE of, and the mean free path stays the one dial that says how much of it there is.
  //
  // An L2 normalize would put the midpoint at about 1.41 times a single medium, so moving the mixture
  // would quietly move the density with it and the two dials would be coupled again - which is the very
  // thing this family of knobs was built to avoid.
  //
  // Guarded, because dividing by a zero sum hands back NaN - and that would not stay in these coefficients
  // but spread through the blur and land on the screen as blocks of nothing. Both factors at zero means no
  // medium at all, so the weights may as well be zero too.
  // The noise field's SHARE, which is a different number from its thickness below and deliberately so:
  // a normalised weight keeps only the ratio, so a thickness folded into it would vanish the moment that
  // model stands alone. It rides in the upper half of the word the tint's blue occupies - three halves in
  // two words left one half spare, and the block is at the 128 bytes Vulkan guarantees.
  vec2 modelShares = unpackHalf2x16(pushConstants.packedTintSharesDust.z);
  float rayleighMieFactor = max(modelShares.x, 0.0);
  float noiseFieldFactor = max(modelShares.y, 0.0);
  float sumFactors = noiseFieldFactor + rayleighMieFactor;
  vec2 modelWeights = vec2(0.0);
  if(sumFactors > 1e-6){
    modelWeights = vec2(noiseFieldFactor, rayleighMieFactor) / sumFactors;
  }

  // And how thick that field is made, on its own dial and read only where the density is built.
  float noiseDensityFactor = max(pushConstants.aerialWeightSkyDepthNoiseDensitySpare.z, 0.0);

  vec3 inscattering = vec3(0.0);
  vec3 transmittance = vec3(1.0);

#ifdef VOLUMETRIC_SCATTERING_DUAL_OUTPUT
  // Declared out here rather than beside the continuation, because the tail below has to see them - and
  // initialised to the empty answer, so that a ray which never enters the march at all (the sun below the
  // horizon, or a degenerate length) leaves them at "no light gathered, nothing taken away" rather than at
  // whatever was on the stack.
  vec3 farInscattering = vec3(0.0);
  vec3 farTransmittance = vec3(1.0);
#endif

  // Only while the sun is above the horizon: below it there is nothing to scatter.
  if((rayLength > 1e-4) && (dot(pushConstants.sunDirectionShaftGain.xyz, vec3(0.0, -1.0, 0.0)) > 0.0)){

    // How much of what passes through is turned toward the eye, by the angle between the ray and the
    // light. The noise model has one Mie lobe and a sharp one; the atmosphere model has the even Rayleigh
    // term beside a gentler Mie one, which is why its sun gets a halo and its sky does not.
    vec3 toLight = -pushConstants.sunDirectionShaftGain.xyz;
    float mu = dot(rayDirection, toLight);
    float onePlusMuSquared = 1.0 + (mu * mu);

    float noiseG2 = noiseModelG * noiseModelG;
    float phaseNoise = (1.0 - noiseG2) /
                       ((4.0 * PI) * pow(((1.0 + noiseG2) - ((2.0 * noiseModelG) * mu)), 1.5));

    float atmosphereG2 = atmosphereModelG * atmosphereModelG;
    float phaseRayleigh = 0.0596831 * onePlusMuSquared;
    float phaseMie = ((0.1193662 * (1.0 - atmosphereG2)) * onePlusMuSquared) /
                     ((2.0 + atmosphereG2) * pow(((1.0 + atmosphereG2) - ((2.0 * atmosphereModelG) * mu)), 1.5));

    // The step count grows with the ray, the way the atmosphere's own march does it: a short ray does not
    // need the same number of samples as one that runs for kilometres, and a fixed count spends them in
    // the wrong place at both ends. The hundredth is the atmosphere's own factor, so anything past a
    // hundred metres gets the full count.
    int stepCount = int(clamp(mix(float(pushConstants.viewBaseIndexFrameIndexFlagsStepCounts.w & 0xffffu),
                                  float(pushConstants.viewBaseIndexFrameIndexFlagsStepCounts.w >> 16u),
                                  clamp(rayLength * 0.01, 0.0, 1.0)),
                              1.0,
                              256.0));
    float timeStep = 1.0 / float(stepCount);

    // The jitter, rotated by the frame counter rather than standing still. A pattern that is the same in
    // every frame cannot average out over time however long one looks at it; rotated, whatever accumulates
    // over frames takes a share of the work off the blur behind this.
    float offset = gJitterOffsets[(((at.x & 7) | ((at.y & 7) << 3)) + int(pushConstants.viewBaseIndexFrameIndexFlagsStepCounts.y)) & 63];

    // How long one segment counts as: the ray's own length over the steps. One length, for what a segment
    // gathers and for what it blocks alike, because they are the same piece of air.
    float segmentLength = max(rayLength * timeStep, 0.0);

    // And how thick that air is - the one dial the physical model has, asked for as a distance.
    //
    // The coefficients below are Earth's at sea level, and their sum in green is 34.5e-6 per metre: a mean
    // free path of twenty-nine kilometres. Over a few hundred metres of track that gathers essentially
    // nothing, which is not a fault in the model but what clear air does. Asking for a shorter mean free
    // path scales the medium to whatever thickness is wanted, and BOTH scattering and extinction with it -
    // they are the same event seen from two sides and cannot be separated for a scattering medium.
    //
    // This replaced a switch between two fixed states, and the numbers say why. One was Earth's air, mean
    // free path twenty-nine kilometres, transmittance 0.99 over three hundred metres: invisible. The other
    // took the distance out of the atmosphere over the ray's own length, which sounds like a statement
    // about geometry but works out as a mean free path of EIGHT METRES - denser than Unity's default for a
    // small box of local fog, laid over the whole world. There the march saturates: at three hundred metres
    // and at four kilometres it returns the very same value, because past an optical depth of a few the
    // inscattering has reached its equilibrium and no longer depends on distance or density at all. A flat,
    // structureless veil over a world multiplied by zero.
    //
    // Everything usable lies between those two, and neither end could reach it. Around 800 to 2000 metres
    // leaves 0.69 to 0.86 of the picture standing over three hundred metres while gathering enough to see.
    float baseExtinction = bR.g + bM.g;
    float mediumScale = 1.0 / (max(pushConstants.sunRadianceMeanFreePath.w, 1.0) * baseExtinction);

    float marchTime = offset * timeStep;

    for(int stepIndex = 0; stepIndex < stepCount; stepIndex++){

      vec3 particlePosition = startPosition + (rayDirection * clamp(marchTime * rayLength, 0.0, rayLength));

      float shellRayleigh, shellMie;
      computeShellDensities(particlePosition, shellRayleigh, shellMie);

      // What this segment scatters toward the eye, and what it takes away from whatever is behind it.
      vec3 scatteringCoefficient;
      vec3 extinctionCoefficient;

      // The field, sampled ONCE for whoever needs it: the noise model uses it as its density, and the
      // Rayleigh/Mie model as the dust that varies its own. Two samples of the same fbm at the same point
      // would be the same number bought twice, and fbm is the expensive line in this loop.
      //
      // Skipped where neither wants it, which is the common case: the physical model on its own, with no
      // dust asked for, never touches it.
      float noiseField = 0.0;
      if((noiseFieldFactor > 0.0) || (noiseModulated && (rayleighMieFactor > 0.0))){
        // Thinned by the shell so that height still matters, and moving with the time so that standing
        // still does not mean standing in a fixed pattern. The movement is the octaves' own and is applied
        // inside the field, which is why nothing but the scale is done to the position here - the clock
        // goes in beside it rather than being folded into it.
        vec3 noisePosition = particlePosition * pushConstants.scaleHeightsNoiseScaleTime.z;
        noiseField = smoothstep(0.0, 1.0, fbm13(noisePosition, pushConstants.scaleHeightsNoiseScaleTime.w));
      }

      vec3 noiseScatteringCoefficient = vec3(0.0);
      vec3 noiseExtinctionCoefficient = vec3(0.0);
      if(noiseFieldFactor > 0.0){

        // No mediumScale here, and that is deliberate: these two coefficients ARE the density, authored
        // directly in per-metre terms. Scaling them by a mean free path as well would be asking for the
        // same thing twice. The physical model needs it because its coefficients are Earth's and fixed.
        //
        // The thickness dial DOES belong here, and it cannot be left to the weight below. A normalised
        // weight keeps only the ratio - (2,0) and (1,0) both come out as (1,0) - so a factor applied there
        // and nowhere else would vanish the moment this model stands alone, which is exactly when one
        // wants to reach for it. Here it survives, and there is no double count: below it is a share, here
        // it is an amount.
        float density = (shellMie * noiseField) * noiseDensityFactor;
        noiseScatteringCoefficient = vec3(density * pushConstants.zNearMaximumDistanceNoiseCoefficients.z) * phaseNoise;
        noiseExtinctionCoefficient = vec3(density * pushConstants.zNearMaximumDistanceNoiseCoefficients.w);

      }

      vec3 rayleighMieScatteringCoefficient = vec3(0.0);
      vec3 rayleighMieExtinctionCoefficient = vec3(0.0);
      if(rayleighMieFactor > 0.0){

        // Rayleigh and Mie side by side, each with its own coefficient and its own phase. The extinction
        // is coloured here rather than grey, which is the whole point of the model: the blue is taken out
        // of what is behind faster than the red.
        //
        // The thickness scales BOTH by the same factor, which is not a simplification to be improved on
        // later. For a scattering medium the two are one event seen from two sides - light is not
        // destroyed, it leaves in another direction - so air that scatters more toward the eye necessarily
        // takes more from what is behind. Albedo stays at or below one; no engine that was looked at breaks
        // that, and scaling the one without the other is where light would come from nowhere.
        //
        // The dust, where it is asked for: the noise field varies the two shell DENSITIES and nothing else.
        // Not the coefficients below - bR and bM are the model itself, the statement that blue is taken
        // away faster than red, and multiplying noise onto that would smear the two ideas together. Varying
        // how MUCH medium is at a point is exactly what dust is, and it leaves the model saying what that
        // medium does to light.
        //
        // Around one and not toward zero. The field's own mean is about a half, so multiplying by it
        // straight would quietly halve the average density as the factor comes up - and then the mean free
        // path would have to be moved to compensate, which is the coupling of two dials that this whole
        // family of knobs exists to avoid. Written as a variation about one, the average holds and the
        // factor means only "how much does it vary".
        float shellRayleighModulated = shellRayleigh;
        float shellMieModulated = shellMie;
        if(noiseModulated){
          float dustVariation = (noiseField - 0.5) * 2.0;
          shellMieModulated *= max(1.0 + (dustVariation * noiseModulation.x), 0.0);
          shellRayleighModulated *= max(1.0 + (dustVariation * noiseModulation.y), 0.0);
        }

        rayleighMieScatteringCoefficient = (((bR * shellRayleighModulated) * phaseRayleigh) + ((bM * shellMieModulated) * phaseMie)) * mediumScale;
        rayleighMieExtinctionCoefficient = ((bR * shellRayleighModulated) + (bM * shellMieModulated)) * mediumScale;

      }

      // The two media in one volume, added rather than chosen between. That is what two species of
      // particle actually do to a ray: each contributes its own scattering and its own extinction, with
      // its own phase function already folded in above.
      scatteringCoefficient = (noiseScatteringCoefficient * modelWeights.x) + (rayleighMieScatteringCoefficient * modelWeights.y);
      extinctionCoefficient = (noiseExtinctionCoefficient * modelWeights.x) + (rayleighMieExtinctionCoefficient * modelWeights.y);

      // Whether this sample is lit at all. This is the line the whole effect is for: a ray through a
      // shadow gathers nothing, one beside it gathers all of it, and the boundary between the two is the
      // shaft.
      float shadowLit = sampleShadow(particlePosition, rayLength);

      // How much this segment contributes: the analytic integral over its whole length, which conserves
      // energy however coarsely the ray is walked - except under the legacy look, which takes the plain
      // length as the old march did.
      //
      // The two are not close where the segments are long. The integral is (1-exp(-sL))/s against a plain
      // L, so it falls short by sL/2: at the old segment length that is eleven per cent in red and twenty
      // in blue. Being wavelength-dependent it shifts the colour as well as the brightness, which is why
      // the legacy switch has to have the old form and not merely a factor.
      vec3 segmentWeight = legacyLook ? vec3(segmentLength)
                                      : segmentIntegral(extinctionCoefficient, segmentLength);

      vec3 segmentTransmittance = exp(-(extinctionCoefficient * segmentLength));

      // WHEN the sample is attenuated, which turns out to matter far more than it looks.
      //
      // The old march added the segment's own optical depth to the running total BEFORE it read the
      // transmittance, so every sample was already dimmed by the segment it sits in. The newer form reads
      // first and dims after, which is the usual way and is what the analytic integral above is derived
      // for.
      //
      // One segment of difference on every sample - and one segment here is not small. Measured against
      // the old code at the old segment length it comes out as exp(sL): 1.27 in red and 1.61 in blue, so
      // brighter AND bluer, not a tint one could dial away. With the order restored the two agree to
      // 1.000 in all three channels.
      if(legacyLook){
        transmittance *= segmentTransmittance;
      }

      if(shadowLit > 0.0){
        inscattering += ((scatteringCoefficient * shadowLit) * segmentWeight) * transmittance;
      }

      if(!legacyLook){
        transmittance *= segmentTransmittance;
      }

      marchTime += timeStep;

    }

#ifdef VOLUMETRIC_SCATTERING_DUAL_OUTPUT

    // The ray carried on past the geometry, to where the sky is. Everything gathered so far is exactly what
    // the near answer is, so the far one starts from it - inscattering is a prefix integral along the ray,
    // which is the whole reason two answers come out of one march instead of two.
    farInscattering = inscattering;
    farTransmittance = transmittance;

    // A budget of its OWN, and this is the point of doing it as a second loop rather than simply marching
    // further. Step count and segment length are derived from the ray's length, so stretching the one ray
    // to the far end would spread the same steps over twenty times the distance and leave five per cent of
    // them in front of the geometry. The near answer - the one almost every pixel actually uses - would get
    // worse in exchange for a far answer only silhouettes need. So the near march keeps precisely the
    // sampling it has today, and the continuation brings its own.
    float farRayLength = pushConstants.zNearMaximumDistanceNoiseCoefficients.y;
    float continuationLength = farRayLength - rayLength;

    if(continuationLength > 1e-4){

      int continuationStepCount = int(clamp(mix(float(pushConstants.viewBaseIndexFrameIndexFlagsStepCounts.w & 0xffffu),
                                                float(pushConstants.viewBaseIndexFrameIndexFlagsStepCounts.w >> 16u),
                                                clamp(continuationLength * 0.01, 0.0, 1.0)),
                                            1.0,
                                            256.0));
      float continuationTimeStep = 1.0 / float(continuationStepCount);
      float continuationSegmentLength = max(continuationLength * continuationTimeStep, 0.0);
      float continuationMarchTime = offset * continuationTimeStep;

      for(int stepIndex = 0; stepIndex < continuationStepCount; stepIndex++){

        // Measured from where the near march stopped, so the two halves meet without a gap and without
        // counting the same piece of air twice.
        vec3 particlePosition = startPosition +
                                (rayDirection * (rayLength + clamp(continuationMarchTime * continuationLength,
                                                                   0.0,
                                                                   continuationLength)));

        float shellRayleigh, shellMie;
        computeShellDensities(particlePosition, shellRayleigh, shellMie);

        vec3 scatteringCoefficient;
        vec3 extinctionCoefficient;

        // The same two media as the near march, weighed the same way. They have to be: the two halves are
        // one ray, and air whose composition changes where the geometry happened to stand is not air.
        float noiseField = 0.0;
        if((noiseFieldFactor > 0.0) || (noiseModulated && (rayleighMieFactor > 0.0))){
          vec3 noisePosition = particlePosition * pushConstants.scaleHeightsNoiseScaleTime.z;
          noiseField = smoothstep(0.0, 1.0, fbm13(noisePosition, pushConstants.scaleHeightsNoiseScaleTime.w));
        }

        vec3 noiseScatteringCoefficient = vec3(0.0);
        vec3 noiseExtinctionCoefficient = vec3(0.0);
        if(noiseFieldFactor > 0.0){
          // The thickness dial here as in the near march - a normalised weight carries only the ratio, so
          // the amount has to be applied where the density is made.
          float density = (shellMie * noiseField) * noiseDensityFactor;
          noiseScatteringCoefficient = vec3(density * pushConstants.zNearMaximumDistanceNoiseCoefficients.z) * phaseNoise;
          noiseExtinctionCoefficient = vec3(density * pushConstants.zNearMaximumDistanceNoiseCoefficients.w);
        }

        vec3 rayleighMieScatteringCoefficient = vec3(0.0);
        vec3 rayleighMieExtinctionCoefficient = vec3(0.0);
        if(rayleighMieFactor > 0.0){
          float shellRayleighModulated = shellRayleigh;
          float shellMieModulated = shellMie;
          if(noiseModulated){
            float dustVariation = (noiseField - 0.5) * 2.0;
            shellMieModulated *= max(1.0 + (dustVariation * noiseModulation.x), 0.0);
            shellRayleighModulated *= max(1.0 + (dustVariation * noiseModulation.y), 0.0);
          }
          rayleighMieScatteringCoefficient = (((bR * shellRayleighModulated) * phaseRayleigh) + ((bM * shellMieModulated) * phaseMie)) * mediumScale;
          rayleighMieExtinctionCoefficient = ((bR * shellRayleighModulated) + (bM * shellMieModulated)) * mediumScale;
        }

        scatteringCoefficient = (noiseScatteringCoefficient * modelWeights.x) + (rayleighMieScatteringCoefficient * modelWeights.y);
        extinctionCoefficient = (noiseExtinctionCoefficient * modelWeights.x) + (rayleighMieExtinctionCoefficient * modelWeights.y);

        // The shadow ray's reach is the FAR length here, not the near one: a sample out at three kilometres
        // needs to be able to ask about occluders that far away, and handing it the near ray's length would
        // cap the query short of itself.
        float shadowLit = sampleShadow(particlePosition, farRayLength);

        vec3 segmentWeight = legacyLook ? vec3(continuationSegmentLength)
                                        : segmentIntegral(extinctionCoefficient, continuationSegmentLength);

        vec3 segmentTransmittance = exp(-(extinctionCoefficient * continuationSegmentLength));

        // The same order as the near march, deliberately, including which side of the attenuation the
        // sample is read on - the two halves are one ray and must not be integrated by two different rules.
        if(legacyLook){
          farTransmittance *= segmentTransmittance;
        }

        if(shadowLit > 0.0){
          farInscattering += ((scatteringCoefficient * shadowLit) * segmentWeight) * farTransmittance;
        }

        if(!legacyLook){
          farTransmittance *= segmentTransmittance;
        }

        continuationMarchTime += continuationTimeStep;

      }

    }

    farInscattering *= pushConstants.sunRadianceMeanFreePath.xyz * pushConstants.sunDirectionShaftGain.w;

#endif

    // The light itself, and then the gain on top of it. Two things, in that order, and coloured because
    // the light is: a low sun reddens what it lights, and the shafts belong to the same light as the
    // ground under them. Where this used to be the gain alone, the shafts stayed just as bright and just
    // as white while the sun set - they were lit by a number rather than by the scene.
    inscattering *= pushConstants.sunRadianceMeanFreePath.xyz * pushConstants.sunDirectionShaftGain.w;

  }

  if((pushConstants.viewBaseIndexFrameIndexFlagsStepCounts.z & VolumetricScatteringFlagLegacyLook) != 0u){

    // The old ending, whole: faded in with the square of the distance so that what is right in front of
    // the eye does not get a wash of haze over it, and capped at a quarter however bright it came out.
    // Applied outside the sun guard above, as it was, so a ray that gathered nothing still ends at zero.
    //
    // And the transmittance goes out at one. That is not an oversight to be tidied away later - the old
    // arrangement wrote no extinction at all and the compose only ever added, so leaving a real one here
    // would mean this switch gave the old brightness over a picture the old code never dimmed.
    float fade = clamp(mix(0.078125,
                           1.0,
                           pow(clamp(linearViewDepth / pushConstants.zNearMaximumDistanceNoiseCoefficients.y, 0.0, 1.0), 2.0)),
                       0.0,
                       0.25);
    inscattering *= fade;
    transmittance = vec3(1.0);

#ifdef VOLUMETRIC_SCATTERING_DUAL_OUTPUT
    // Under the old look the far answer is simply the near one. That mode exists to reproduce a picture
    // which had no such distinction in it, so inventing one here would make the switch stop doing the one
    // thing it is for.
    farInscattering = inscattering;
    farTransmittance = transmittance;
#endif

  }else{

    // What the distance itself adds over and above the march, and takes away with it. Weighted toward the
    // horizon on a ray that hit nothing, so that the sky overhead stays clear while the distance closes in.
    float aerialWeight = pushConstants.aerialWeightSkyDepthNoiseDensitySpare.x;
    if(aerialWeight > 0.0){
      float f = clamp(1.0 - exp(-pow(clamp(linearViewDepth / pushConstants.zNearMaximumDistanceNoiseCoefficients.y, 0.0, 1.0), 1.5)), 0.0, 1.0) *
                (hasGeometry ? 1.0 : pow(1.0 - clamp(rayDirection.y, 0.0, 1.0), 16.0));
      inscattering += ((aerialWeight * aerialColour) * f) * transmittance;
      transmittance *= 1.0 - f;

#ifdef VOLUMETRIC_SCATTERING_DUAL_OUTPUT
      // The same term for the far answer, but computed as what it is: a ray that reaches the sky. It gets
      // the full distance instead of the geometry's, and the horizon weighting that a ray hitting nothing
      // gets - because that is what this second answer describes. Taking the near ray's numbers here would
      // hand the sky the aerial perspective of the tower standing in front of it, which is the very
      // confusion this whole second output exists to end.
      float farF = clamp(1.0 - exp(-1.0), 0.0, 1.0) * pow(1.0 - clamp(rayDirection.y, 0.0, 1.0), 16.0);
      farInscattering += ((aerialWeight * aerialColour) * farF) * farTransmittance;
      farTransmittance *= 1.0 - farF;
#endif

    }

  }

  // The tint, and it goes here rather than beside the shaft gain on purpose: at this point everything the
  // pass gathered is in, the march and the aerial term alike. Folded in earlier it would colour what the
  // ray picked up and leave the distance haze grey beside it, which is the kind of half-applied setting one
  // spends an evening not finding.
  //
  // What it does NOT touch is the extinction. Tinting what the air gives is a look; tinting what it takes
  // away is a different statement about the medium, and the two do not belong on one dial. This is the
  // coloured sibling of the shaft gain above - an admitted cheat, in the same place, on the same half.
  vec3 tint = vec3(unpackHalf2x16(pushConstants.packedTintSharesDust.x),
                   unpackHalf2x16(pushConstants.packedTintSharesDust.y).x);
  inscattering *= tint;
#ifdef VOLUMETRIC_SCATTERING_DUAL_OUTPUT
  farInscattering *= tint;
#endif

  // The last net. Everything above is guarded, but these buffers are read by two more passes and put onto
  // the picture, so one NaN that slipped through would not stay where it was made - it would spread
  // through the blur and land on the screen as blocks of nothing.
  if(any(isnan(inscattering)) || any(isinf(inscattering))){
    inscattering = vec3(0.0);
  }
  if(any(isnan(transmittance)) || any(isinf(transmittance))){
    transmittance = vec3(1.0);
  }

  // The alpha of the first two carries nothing now - the depth has an image of its own, which is what
  // lets it be full float and lets it be written once instead of copied along.
  imageStore(uDestinationInscatteringTexture, at, vec4(max(inscattering, vec3(0.0)), 1.0));
  imageStore(uDestinationExtinctionTexture, at, vec4(clamp(transmittance, vec3(0.0), vec3(1.0)), 1.0));
  imageStore(uDestinationDepthTexture, at, vec4(linearViewDepth));

#ifdef VOLUMETRIC_SCATTERING_DUAL_OUTPUT
  // The same net as above, and for the same reason: these two go through the blur and onto the picture as
  // well, so one infinity here would not stay where it was made.
  if(any(isnan(farInscattering)) || any(isinf(farInscattering))){
    farInscattering = vec3(0.0);
  }
  if(any(isnan(farTransmittance)) || any(isinf(farTransmittance))){
    farTransmittance = vec3(1.0);
  }
  imageStore(uDestinationFarInscatteringTexture, at, vec4(max(farInscattering, vec3(0.0)), 1.0));
  imageStore(uDestinationFarExtinctionTexture, at, vec4(clamp(farTransmittance, vec3(0.0), vec3(1.0)), 1.0));
#endif

}
