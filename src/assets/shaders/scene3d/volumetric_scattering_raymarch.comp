#version 450 core

#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable
#extension GL_GOOGLE_include_directive : enable

// Volumetric scattering, the first of its three steps: the ray march. It walks the ray from the eye to
// whatever the depth buffer says is in the way and sums up the light scattered into that ray along it -
// the part the atmosphere here cannot do, because its camera volume carries no shadow lookup at all and
// so has no light shafts.
//
// Half resolution, because the result is smooth and the bilateral blur behind it smooths it further. The
// alpha channel carries the LINEAR VIEW DEPTH rather than an opacity: the blur and the upsample both need
// it as their edge, so that a bright shaft is not smeared across the silhouette of the thing casting it.
//
// The maths is kept as it was tuned, including the parts that look odd - see the flag word in the push
// constants for the oddest of them. Where this file departs from that at all, it is because of something
// this engine does differently, and it says so where it does.

#include "view.glsl"

// A measurement, not a feature: writes a gradient and returns, before a single line of the march runs. It
// answers one question and only one - does what this pass writes reach the screen at all - and it answers
// it without depending on the depth, the views, the shadows or the maths. Switch it on when the effect is
// invisible and it is not clear whether the chain or the arithmetic is at fault.
//#define VOLUMETRIC_SCATTERING_DEBUG_PLUMBING

// The measurement one layer in from that: writes the push constants themselves, scaled into something a
// viewer can read. The gradient above proves the pass runs and its result arrives - it proves nothing
// about what the pass was TOLD, because it uses none of it. If the scale heights arrive as zero, every
// density is exp(-inf) and the whole march is zero however right the arithmetic around it is.
//#define VOLUMETRIC_SCATTERING_DEBUG_INPUTS

// The second measurement, one step further in: every sample counts as fully lit, so the shadow lookup is
// out of the picture while the rest of the march stays in it. What should come out is a haze that grows
// with distance and brightens toward the sun - no shafts, because shafts ARE the shadow. If this shows
// something and the shadowed version does not, the lookup is at fault and not the arithmetic.
//#define VOLUMETRIC_SCATTERING_DEBUG_NO_SHADOW

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2DArray uTextureDepth;

layout(std140, set = 0, binding = 1) uniform uboViews {
  View views[256];
} uView;

// rgb = the light scattered into this ray, a = linear view depth for the two steps behind this one.
layout(set = 0, binding = 2, rgba16f) writeonly uniform image2DArray uDestinationTexture;

layout(push_constant) uniform PushConstants {
  vec4 sunDirectionStrength;      // xyz = direction the sunlight travels, w = strength
  // x = how depth becomes a distance, y = how far a ray without geometry reaches and the distance the
  // result is faded in over, z = the light's own strength. That last one matters more than it looks: the
  // coefficients below are per metre at sea level, so over a few kilometres of ray they only add up to
  // hundredths - at one the whole effect computes correctly and stays invisible.
  vec4 zNearMaximumDistanceSunIntensitySpare;
  vec4 centreBottomRadiusTop;     // xyz = the shell's centre, w = its bottom radius
  vec4 topRadiusHeightsSpare;     // x = top radius, y = Rayleigh scale height, z = Mie scale height
  uvec4 viewBaseIndexFrameIndexSpare; // x = the first view of this pass, y = frame counter, zw unused
  // Everything that is a whole number or a switch, kept out of the float vectors above rather than
  // squeezed into their spare lanes: x = flags, y = the fewest steps a ray is walked in, z = the most.
  //
  // Flag bit 0 - VolumetricScatteringFlagRayLengthSegments - picks which step length the march uses. Clear
  // takes it from the distance out of the atmosphere while the positions walk the view ray, which is two
  // different scales in one formula and is a good part of why the effect carries at all; set takes the
  // ray's own length, which is the physically consistent reading and much fainter. A switch rather than a
  // define, so the two can be held against each other on one and the same frame.
  uvec4 flagsStepCountsSpare;
} pushConstants;

const uint VolumetricScatteringFlagRayLengthSegments = 1u << 0;

// The shadow lookup, which is the whole reason this effect exists: without it every sample along the ray
// is lit and the result is a wash of haze, with it the samples that stand in shadow contribute nothing and
// what is left are the shafts between them.
//
// shadows.glsl is written for a fragment shader and asks its includer for the few things that differ. Two
// of those matter here: NOTEXCOORDS, because there are no interpolated texture coordinates to decorrelate
// the PCSS rotation with, and SHADOWS_SCREEN_POSITION, because gl_FragCoord does not exist in a compute
// shader - the invocation stands in for it.
#include "math.glsl"

#define SHADOWS
#define NOTEXCOORDS
#define NUM_SHADOW_CASCADES 4
#define inFrameIndex pushConstants.viewBaseIndexFrameIndexSpare.y
#define SHADOWS_SCREEN_POSITION vec2(gl_GlobalInvocationID.xy)

const uint SHADOWMAP_MODE_NONE = 1;
const uint SHADOWMAP_MODE_PCF = 2;
const uint SHADOWMAP_MODE_DPCF = 3;
const uint SHADOWMAP_MODE_PCSS = 4;
const uint SHADOWMAP_MODE_MSM = 5;

// All of this lives in set 0 rather than in the set 3 the other shadow readers use: those share a pipeline
// layout with the atmosphere, and this pass has one of its own. Putting them anywhere but set 0 would mean
// declaring empty layouts for the sets in between, which Vulkan requires and which would buy nothing.
layout(set = 0, binding = 3, std140) uniform uboCascadedShadowMaps {
  mat4 shadowMapMatrices[NUM_SHADOW_CASCADES];
  vec4 shadowMapSplitDepthsScales[NUM_SHADOW_CASCADES];
  vec4 constantBiasNormalBiasSlopeBiasClamp[NUM_SHADOW_CASCADES];
  uvec4 metaData; // x = type
} uCascadedShadowMaps;

layout(set = 0, binding = 4) uniform sampler2DArray uCascadedShadowMapTexture;

// Both views of the one binding, always - not behind a define as elsewhere. Which of the four modes runs
// is a run-time switch, so shadows.glsl compiles the PCF case whatever the mode is, and that case names
// the comparison sampler. Declaring only one of the two therefore does not build at all; declaring both
// costs nothing where the mode never reaches them.
//
// Yay! Binding Aliasing! :-)
layout(set = 0, binding = 4) uniform sampler2DArrayShadow uCascadedShadowMapTextureShadow;

// What shadows.glsl reads out of its includer. lightDirection is the direction the light TRAVELS, which is
// what the functions in there expect to be handed the negation of.
vec3 inWorldSpacePosition, workNormal, lightDirection;

#include "shadows.glsl"

// Mean cosine of the Mie phase, and the scattering coefficients at sea level. Left in the units they are
// defined in, because the world here is in metres too - the track's own sample spacing says so - so
// nothing about them needs converting.
const float g = 0.76;
const float g2 = g * g;
const vec3 bM = vec3(21e-6);
const vec3 bR = vec3(5.8e-6, 13.5e-6, 33.1e-6);

// (x:5,y:5)-offseted bayer's optimum 8x8 index matrix (1973). Every pixel starts its walk at a slightly
// different point between two steps, so that eight samples read as a smear rather than as eight bands.
const float gJitterOffsets[64] = float[](
  0.265625, 0.703125, 0.453125, 0.531250, 0.281250, 0.718750, 0.468750, 0.515625,
  0.890625, 0.078125, 0.828125, 0.156250, 0.906250, 0.093750, 0.843750, 0.140625,
  0.390625, 0.578125, 0.328125, 0.656250, 0.406250, 0.593750, 0.343750, 0.640625,
  0.796875, 0.234375, 0.984375, 0.000000, 0.750000, 0.187500, 0.937500, 0.046875,
  0.296875, 0.734375, 0.484375, 0.500000, 0.250000, 0.687500, 0.437500, 0.546875,
  0.921875, 0.109375, 0.859375, 0.125000, 0.875000, 0.062500, 0.812500, 0.171875,
  0.421875, 0.609375, 0.359375, 0.625000, 0.375000, 0.562500, 0.312500, 0.671875,
  0.765625, 0.203125, 0.953125, 0.031250, 0.781250, 0.218750, 0.968750, 0.015625
);

// How much air and how much haze there is where this sample sits. Both fall away with height above the
// shell's bottom, each at its own rate - haze hugs the ground, air reaches much further up.
void computeDensities(const in vec3 aPosition, out float aRayleigh, out float aMie){
  float height = length(aPosition - pushConstants.centreBottomRadiusTop.xyz) - pushConstants.centreBottomRadiusTop.w;
  aRayleigh = exp(-(max(height, 0.0) / pushConstants.topRadiusHeightsSpare.y));
  aMie = exp(-(max(height, 0.0) / pushConstants.topRadiusHeightsSpare.z));
}

// How far this ray runs before it leaves a sphere of the given radius about the shell's centre.
float computeEscapeLength(const in vec3 aPosition, const in vec3 aDirection, const in float aRadius){
  vec3 v = aPosition - pushConstants.centreBottomRadiusTop.xyz;
  float b = dot(v, aDirection);
  float c = dot(v, v) - (aRadius * aRadius);
  float det = (b * b) - c;
  if(det < 0.0){
    return -1.0;
  }else{
    det = sqrt(det);
    float t1 = (-b) - det;
    float t2 = (-b) + det;
    return (t1 >= 0.0) ? t1 : t2;
  }
}

// How much of the light reaches this point in the volume. The cascade walk is the one getFastCascadedShadow
// does, written out here rather than called, because that one carries a receiver-plane bias prologue meant
// for a surface and a raytracing branch of its own; RAYTRACING is handled below in its place.
//
// workNormal is the piece a volume does not have. Setting it to the direction the light comes FROM makes
// the normal-bias term degenerate - dot(N,L) is one, so both the normal and the slope offset fall to zero
// and only the constant bias is left. That is the honest answer for a point that has no surface.
float sampleShadow(const in vec3 aWorldPosition, const in float aMaximumDistance){

#ifdef VOLUMETRIC_SCATTERING_DEBUG_NO_SHADOW
  return 1.0;
#else

  inWorldSpacePosition = aWorldPosition;
  workNormal = -lightDirection;

#if defined(RAYTRACING)

  float rayOffset = 0.0;
  return getRaytracedFastHardShadow(aWorldPosition, workNormal, normalize(-lightDirection), rayOffset, aMaximumDistance);

#else

  vec3 shadowUVW;
  float shadow = -1.0;

  int cascadedShadowMapIndex = 0;
  while(cascadedShadowMapIndex < NUM_SHADOW_CASCADES){
    shadow = doCascadedShadowMapShadow(cascadedShadowMapIndex, -lightDirection, shadowUVW);
    if(shadow < 0.0){
      cascadedShadowMapIndex++;
    }else{
      break;
    }
  }

  // Past the last cascade there is nothing to ask, and a sample nobody can answer for counts as lit: the
  // alternative would be a wall of shadow at the cascade edge.
  return (shadow < 0.0) ? 1.0 : clamp(shadow, 0.0, 1.0);

#endif

#endif

}

void main(){

  ivec3 destinationSize = imageSize(uDestinationTexture);
  ivec3 at = ivec3(gl_GlobalInvocationID.xyz);

  if(any(greaterThanEqual(at, destinationSize))){
    return;
  }

#ifdef VOLUMETRIC_SCATTERING_DEBUG_PLUMBING
  // Red across, green down, blue by layer - so that a wrong resolution, a wrong layer or a compose that
  // never reads this show up as themselves rather than as "nothing".
  imageStore(uDestinationTexture,
             at,
             vec4((vec2(at.xy) / vec2(destinationSize.xy)) * 0.5, float(at.z) * 0.25, 1.0));
  return;
#endif

#ifdef VOLUMETRIC_SCATTERING_DEBUG_INPUTS
  // Each channel one number that has to be right, scaled so that "as expected" reads as one:
  //   red   = the Rayleigh scale height against its 8000 metres
  //   green = the shell's bottom radius against its 6360 kilometres
  //   blue  = the sun's y component, offset so that below the horizon is dark and above it is bright;
  //           a flat 0.5 means the direction arrived as zero and the march is skipped outright
  //   alpha = the light's own strength against its twenty
  // A black picture here means the pass is being told nothing, and no arithmetic downstream can help.
  imageStore(uDestinationTexture,
             at,
             vec4(pushConstants.topRadiusHeightsSpare.y / 8000.0,
                  pushConstants.centreBottomRadiusTop.w / 6360000.0,
                  (pushConstants.sunDirectionStrength.y * 0.5) + 0.5,
                  pushConstants.zNearMaximumDistanceSunIntensitySpare.z / 20.0));
  return;
#endif

  uint viewIndex = pushConstants.viewBaseIndexFrameIndexSpare.x + uint(at.z);
  mat4 projectionMatrix = uView.views[viewIndex].projectionMatrix;
  mat4 inverseViewMatrix = uView.views[viewIndex].inverseViewMatrix;
  mat4 inverseProjectionMatrix = uView.views[viewIndex].inverseProjectionMatrix;

  // The depth is at FULL resolution and this march is at half, so the invocation is not a texel of it: the
  // two have to be mapped through their sizes. Fetching at `at` reads the top left quarter of the depth
  // buffer and stretches it over the whole picture - every ray then stops where something stands somewhere
  // else entirely, which looks like shadows without casters and like the whole effect being offset.
  //
  // Through the ratio rather than a fixed two, because half of an odd width is not half.
  ivec2 depthSize = ivec2(textureSize(uTextureDepth, 0).xy);
  ivec2 depthAt = clamp(ivec2((vec2(at.xy) + vec2(0.5)) * (vec2(depthSize) / vec2(destinationSize.xy))),
                        ivec2(0),
                        depthSize - ivec2(1));

  float rawDepth = texelFetch(uTextureDepth, ivec3(depthAt, at.z), 0).x;

  // The ray, from the near plane to whatever stands in the way. Reconstructed through the inverse
  // projection first and then out of view space, which is the same route fog.frag takes - going straight
  // through one combined inverse loses precision where it is needed most, far away.
  vec2 texCoord = (vec2(at.xy) + vec2(0.5)) / vec2(destinationSize.xy);
  vec2 clipSpaceCoord = (texCoord * 2.0) - vec2(1.0);

  // Which way round the depth runs, read off the projection itself the way fog.frag reads it. This has to
  // be known BEFORE the near plane is unprojected, and that is not a detail: under reversed Z the near
  // plane is at one and the FAR plane is at zero. Unprojecting zero as if it were the near plane asks for
  // a point at infinity on an infinite projection - w goes to nothing, the start position comes back
  // enormous, and every density along the ray is exp(-enormous), which is nought. The march then runs in
  // empty space and returns zero no matter what else is right, which is exactly what it did.
  bool reversedZ = projectionMatrix[2][3] < -1e-7;
  bool hasGeometry = reversedZ ? (rawDepth > 0.0) : (rawDepth < 1.0);

  vec4 nearView = inverseProjectionMatrix * vec4(clipSpaceCoord, reversedZ ? 1.0 : 0.0, 1.0);
  vec3 startPosition = (inverseViewMatrix * vec4(nearView.xyz / nearView.w, 1.0)).xyz;

  // The eye, for the direction of a ray that has nothing to aim at. On a perspective projection the near
  // plane point minus the eye IS the ray direction, so this needs no second unprojection.
  vec3 eyePosition = inverseViewMatrix[3].xyz;
  vec3 rayDirection = startPosition - eyePosition;
  float rayDirectionLength = length(rayDirection);
  if(rayDirectionLength < 1e-8){
    imageStore(uDestinationTexture, at, vec4(vec3(0.0), pushConstants.zNearMaximumDistanceSunIntensitySpare.y));
    return;
  }
  rayDirection /= rayDirectionLength;

  // Both start at the far end a ray without geometry is given, and are only replaced where there is
  // something to replace them with.
  //
  // The depth is NOT the view-space distance of the end point, which would be the obvious thing to write
  // here. It is zNear over the raw value instead, because that is what the compose behind this computes
  // from the full-resolution depth to weigh its four taps against - and two quantities that are compared
  // with each other have to be the same quantity.
  //
  // And the length is capped at the same far end even where there IS geometry: eight steps spread over a
  // ten kilometre ray are eight steps a kilometre apart, which is not a march, it is four samples of
  // nothing and a guess. The cap costs the far end of such a ray and keeps the near end worth having.
  float rayLength = pushConstants.zNearMaximumDistanceSunIntensitySpare.y;
  float linearViewDepth = pushConstants.zNearMaximumDistanceSunIntensitySpare.y;

  // Sky is NOT skipped here, unlike in the fog: a light shaft is at its most visible against it, and a ray
  // with nothing in its way is exactly the one that should be allowed to gather light for its whole
  // length. What it must not do is march to the far plane - the projection is an infinite one, so the
  // reconstruction there divides by a w of zero and hands back infinities, which is how a NaN gets into
  // the buffer and comes out of the compose as blocks of nothing. So such a ray gets a finite end
  // instead, and the reconstruction is only trusted where it can be.
  if(hasGeometry){
    vec4 farView = inverseProjectionMatrix * vec4(clipSpaceCoord, rawDepth, 1.0);
    vec3 farViewPosition = farView.xyz / farView.w;
    if(!(any(isinf(farViewPosition)) || any(isnan(farViewPosition)))){
      vec3 endPosition = (inverseViewMatrix * vec4(farViewPosition, 1.0)).xyz;
      rayLength = min(length(endPosition - startPosition), pushConstants.zNearMaximumDistanceSunIntensitySpare.y);
      linearViewDepth = pushConstants.zNearMaximumDistanceSunIntensitySpare.x / max(rawDepth, 1e-7);
    }
  }

  if(rayLength < 1e-4){
    imageStore(uDestinationTexture, at, vec4(vec3(0.0), linearViewDepth));
    return;
  }

  lightDirection = pushConstants.sunDirectionStrength.xyz;

  vec3 scattering = vec3(0.0);

  // Only while the sun is above the horizon: below it there is nothing to scatter.
  if(dot(pushConstants.sunDirectionStrength.xyz, vec3(0.0, -1.0, 0.0)) > 0.0){

    // The two phase functions: how much of what passes through is turned toward the eye, by the angle
    // between the ray and the light. Rayleigh is nearly even, Mie is sharply forward - which is why the
    // sun gets a halo and the sky does not.
    vec3 toLight = -pushConstants.sunDirectionStrength.xyz;
    float mu = dot(rayDirection, toLight);
    float onePlusMuSquared = 1.0 + (mu * mu);
    float phaseRayleigh = 0.0596831 * onePlusMuSquared;
    float phaseMie = ((0.1193662 * (1.0 - g2)) * onePlusMuSquared) /
                     ((2.0 + g2) * pow(((1.0 + g2) - ((2.0 * g) * mu)), 1.5));

    // The step count grows with the ray, the way the atmosphere's own march does it: a short ray does not
    // need the same number of samples as one that runs for kilometres, and a fixed count spends them in
    // the wrong place at both ends. The hundredth is the atmosphere's own factor, so anything past a
    // hundred metres gets the full count.
    int stepCount = int(clamp(mix(float(pushConstants.flagsStepCountsSpare.y),
                                  float(pushConstants.flagsStepCountsSpare.z),
                                  clamp(rayLength * 0.01, 0.0, 1.0)),
                              1.0,
                              256.0));
    float timeStep = 1.0 / float(stepCount);

    // The jitter, rotated by the frame counter rather than standing still. A pattern that is the same in
    // every frame cannot average out over time however long one looks at it; rotated, whatever accumulates
    // over frames takes a share of the work off the blur behind this. The static form is the one that was
    // built, this is the alternative it carried alongside - switch the define off to compare the two.
#define VOLUMETRIC_SCATTERING_ROTATING_JITTER
#ifdef VOLUMETRIC_SCATTERING_ROTATING_JITTER
    float offset = gJitterOffsets[(((at.x & 7) | ((at.y & 7) << 3)) + int(pushConstants.viewBaseIndexFrameIndexSpare.y)) & 63];
#else
    float offset = gJitterOffsets[((at.x & 7) | ((at.y & 7) << 3)) & 63];
#endif

    float segmentLength;
    if((pushConstants.flagsStepCountsSpare.x & VolumetricScatteringFlagRayLengthSegments) != 0u){
      segmentLength = rayLength * timeStep;
    }else{
      // The distance out of the atmosphere, divided by the step count - while the positions below walk
      // the view ray. See the push constant block; this is what makes the result carry.
      segmentLength = computeEscapeLength(startPosition, rayDirection, pushConstants.topRadiusHeightsSpare.x) * timeStep;
    }

    vec3 sumRayleigh = vec3(0.0);
    vec3 sumMie = vec3(0.0);
    float opticalDepthRayleigh = 0.0;
    float opticalDepthMie = 0.0;

    float time = offset * timeStep;

    for(int stepIndex = 0; stepIndex < stepCount; stepIndex++){

      float distanceAlong = time * rayLength;
      vec3 particlePosition = startPosition + (rayDirection * clamp(distanceAlong, 0.0, rayLength));

      float densityRayleigh, densityMie;
      computeDensities(particlePosition, densityRayleigh, densityMie);
      densityRayleigh *= segmentLength;
      densityMie *= segmentLength;

      opticalDepthRayleigh += densityRayleigh;
      opticalDepthMie += densityMie;

      // Whether this sample is lit at all. This is the line the whole effect is for: the optical depth
      // above says how much light SURVIVES the journey to the eye, and this says how much arrived at the
      // sample in the first place. A ray through a shadow gathers nothing, one beside it gathers all of
      // it, and the boundary between the two is the shaft.
      float shadowLit = sampleShadow(particlePosition, rayLength);

      if(shadowLit > 0.0){
        vec3 transmittance = exp(-((bR * opticalDepthRayleigh) + (bM * opticalDepthMie))) * shadowLit;
        sumRayleigh += transmittance * densityRayleigh;
        sumMie += transmittance * densityMie;
      }

      time += timeStep;

    }

    scattering = pushConstants.zNearMaximumDistanceSunIntensitySpare.z *
                 (((sumRayleigh * bR) * phaseRayleigh) + ((sumMie * bM) * phaseMie));

  }

  // Faded in with the square of the distance, so that what is right in front of the eye does not get a
  // wash of haze over it, and capped at a quarter however bright it came out.
  float fade = clamp(mix(0.078125,
                         1.0,
                         pow(clamp(linearViewDepth / pushConstants.zNearMaximumDistanceSunIntensitySpare.y, 0.0, 1.0), 2.0)),
                     0.0,
                     0.25);

  scattering *= fade * pushConstants.sunDirectionStrength.w;

  // The last net. Everything above is guarded, but this buffer is read by two more passes and added onto
  // the picture, so one NaN that slipped through would not stay where it was made - it would spread
  // through the blur and land on the screen as blocks of nothing.
  if(any(isnan(scattering)) || any(isinf(scattering))){
    scattering = vec3(0.0);
  }

  imageStore(uDestinationTexture, at, vec4(scattering, linearViewDepth));

}
