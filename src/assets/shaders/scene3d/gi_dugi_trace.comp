#version 460 core

// DUGI probe ray tracing pass.
//
// For every probe of every cascade it traces GI_DUGI_RAYS_PER_PROBE rays against the scene TLAS and stores, per ray,
// the shaded radiance towards the probe plus the hit distance. The probe update passes then integrate this ray data
// into the irradiance and visibility probe data structures. Ray directions are generated deterministically (spherical
// Fibonacci rotated by a per-frame random rotation) so the update passes can reconstruct them without a direction buffer.

#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

// Trace backend (compile-time -DGI_TRACE_BACKEND): 0 = hardware ray query (default), 2 = non-raytraced Reflective Shadow
// Map gather. The probe iteration / relocation / multi-bounce / particle injection / ray-data encode in main() are IDENTICAL
// for both backends — only the closest-hit (giTraceClosestHit) and the descriptor sets it needs differ.
#ifndef GI_TRACE_BACKEND
  #define GI_TRACE_BACKEND 0
#endif
#if GI_TRACE_BACKEND != 2
  #extension GL_EXT_ray_query : require
#endif

/* clang-format off */

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

#if GI_TRACE_BACKEND == 2

// RSM backend: no TLAS / no ray query. The gather shading still evaluates the analytic lights — these live in the global
// descriptor set under LIGHTS, independently of RAYTRACING; without RAYTRACING the engine binds the non-RT global set layout
// (no TLAS, textures at binding 8). Ray-traced shadows are off (no TLAS); the RSM already bakes the sun's visibility into its
// flux. giTraceClosestHit is provided below (after gi_rt_gather.glsl) by the RSM gather.
#define GI_GATHER_RSM
#define LIGHTS
#define USE_MATERIAL_BUFFER_REFERENCE
#define USE_BUFFER_REFERENCE
#define GI_GATHER_TRACE_SHADOWS 0
#define CULLMASK_ALL 0xFFu // the RSM backend ignores the cull mask; main() still passes CULLMASK_ALL (otherwise from raytracing.glsl)
#include "globaldescriptorset.glsl"

#else

// The gather layer needs the engine's global descriptor set (TLAS, lights, materials, textures) and the ray helpers.
#define RAYTRACING
#define LIGHTS
#define USE_MATERIAL_BUFFER_REFERENCE
#define USE_BUFFER_REFERENCE

#include "globaldescriptorset.glsl"
#include "raytracing.glsl"

#endif

// Particle LBVH (built per frame on the GPU) software-traced here to inject particles — which are NOT in the hardware
// ray-tracing BLAS (too many, too dynamic) — into the probe irradiance. Descriptor-free: the structs come from particle_bvh.glsl
// and the BDA refs + queries from particle_bvh_trace.glsl; the emitter/node buffer device addresses + count are pushed
// (pushConstants.particleBVH + emissiveGIParticleCount.z). Disabled at runtime when particleCount == 0.
#include "particle_bvh.glsl"
#include "particle_bvh_trace.glsl"

// Sky on ray miss. The environment maps mirror the mesh shading IBL set (mesh_rendering_pass_descriptorset.glsl set 1
// binding 2): [0..2] = env A (GGX/Charlie/Lambertian), [3..5] = env B (the atmosphere-inclusive set when planets/atmosphere
// are active). GI_GATHER_SKY mirrors getIBLDiffuse() from pbr.glsl exactly: the sky diffuse irradiance in the ray
// direction, dual-blended by env B's alpha (= per-texel atmosphere existence; 0 where there is no/partial atmosphere, and
// the whole dual term is a no-op when no planet/atmosphere is active). Integrating this per missed ray bakes the sky into
// the probe irradiance, correctly occluded (a probe whose rays mostly hit geometry sees little sky).

layout(set = 1, binding = 4) uniform samplerCube uDUGIEnvironmentMaps[6];

vec3 dugiGatherSky(const in vec3 dir){
  vec3 irradiance = textureLod(uDUGIEnvironmentMaps[2], dir, 0.0).xyz;       // Lambertian (diffuse irradiance), env A
  vec4 envB = textureLod(uDUGIEnvironmentMaps[5], dir, 0.0);                  // Lambertian, env B (atmosphere); w = coverage
  return mix(irradiance, envB.xyz, envB.w);
}

#define GI_GATHER_SKY(dir) dugiGatherSky(dir)

// Per-planet blend/grass maps (bindless, indexed by planet object index) on set 2, so planet hits get the full material
// layer blend instead of just the default ground material. RT closest-hit only; the RSM backend reads albedo from the RSM
// (and reuses set 2 for the RSM source textures instead).
#if GI_TRACE_BACKEND != 2
#define GI_GATHER_PLANET_TEXTURES
#define GI_GATHER_PLANET_TEXTURES_SET 2
#endif

// Global GI-emissive master regulators, delivered via the push constants. The push block is included further below, so these
// file-scope globals (set in main() before any hit is shaded) let giGatherShadeHit read the values without a signature change.
float dugiEmissiveScale = 1.0;
float dugiEmissiveMax = uintBitsToFloat(0x7f800000u);
#define GI_GATHER_EMISSIVE_SCALE dugiEmissiveScale
#define GI_GATHER_EMISSIVE_MAX dugiEmissiveMax

#include "gi_rt_gather.glsl"

#if GI_TRACE_BACKEND == 2
// =====================================================================================================================
//  RSM backend: the non-raytraced closest-hit. Reads the sun's reflective shadow map (light-POV G-buffer) rendered by the
//  ReflectiveShadowMapRenderPass and gathers, per probe ray, the lit RSM texels (virtual point lights) best aligned with the
//  ray direction, returning their weighted average as the hit surface. main() then shades it EXACTLY like a ray-query hit
//  (direct light from the light BVH without ray-traced shadows + previous-frame multi-bounce), so relocation, multi-bounce,
//  particle injection and the ray-data encode are byte-for-byte identical to the hardware path. albedo = RSM color (which is
//  currently flux; treated as albedo here — corrected later by the planned mesh.frag RSM-albedo output variant).
// =====================================================================================================================
layout(set = 2, binding = 0) uniform sampler2D uReflectiveShadowMapColor;      // rgb = reflected flux (used as albedo)
layout(set = 2, binding = 1) uniform sampler2D uReflectiveShadowMapNormalUsed; // xyz = encoded world normal, w = used flag
layout(set = 2, binding = 2) uniform sampler2D uReflectiveShadowMapDepth;      // light-space depth
layout(set = 2, binding = 3, std140) uniform RSMData {
  // Byte-mirrors TGlobalIlluminationRadianceHintsRSMUniformBufferData (the same UBO the radiance-hints RSM inject pass uses).
  mat4 worldToReflectiveShadowMapMatrix; // unused here
  mat4 reflectiveShadowMapToWorldMatrix; // reconstructs a VPL world position from (uv, depth)
  mat4 modelViewProjectionMatrix;        // unused here
  vec4 spreadExtents[4];                 // unused here
  vec4 lightDirection;                   // unused here
  vec4 lightPosition;                    // unused here
  vec4 scaleFactors;                     // unused here
  ivec4 countSamples;                    // unused here
} rsm;

// Number of RSM texels sampled per probe ray (spread over the whole RSM); more = less noise, linear cost. Env/define overridable.
#ifndef GI_DUGI_RSM_SAMPLES
  #define GI_DUGI_RSM_SAMPLES 64
#endif
// Phong-lobe exponent of the per-ray RSM gather (how tightly a VPL must align with the ray to count). Env/define overridable.
#ifndef GI_DUGI_RSM_SHARPNESS
  #define GI_DUGI_RSM_SHARPNESS 16.0
#endif
// Nearest-hit band of the two-pass gather: a real ray hits only the nearest surface, so VPLs farther than nearestDistance *
// this factor are behind it and rejected (else distant lit surfaces leak in). 1.0 = hard nearest, larger = softer. Overridable.
#ifndef GI_DUGI_RSM_NEAR_BAND
  #define GI_DUGI_RSM_NEAR_BAND 1.5
#endif

// PCG3D hash -> a per-(probe, ray, frame) Cranley-Patterson rotation offset in [0,1)^2 for the RSM sample set. main() sets the
// file-scope gDUGIRSMJitter below from the probe/ray indices + frame (pushConstants is only included further down, so this
// mirrors the dugiEmissive* pattern and lets the gather read it without a signature change). Rotating the fixed stratified taps
// per probe/ray and every frame makes them cover the whole RSM over the DUGI temporal blend, instead of every probe/ray/frame
// seeing the same 64 texels (a fixed global pattern is a near-blind subsample of a large RSM).
vec2 dugiRSMJitter(const in uvec3 seed){
  uvec3 v = (seed * 1664525u) + 1013904223u;
  v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
  v ^= v >> 16u;
  v.x += v.y * v.z; v.y += v.z * v.x;
  return vec2(v.xy) * (1.0 / 4294967296.0);
}
vec2 gDUGIRSMJitter = vec2(0.0); // set per invocation in main() before giTraceClosestHit

// 2D low-discrepancy point on the unit square (golden ratio), Cranley-Patterson-rotated by gDUGIRSMJitter, for RSM sample i of n.
vec2 dugiRSMSampleUV(const in int i, const in int n){
  const float PHI = 1.6180339887498949;
  vec2 base = vec2(fract((float(i) + 0.5) * (1.0 / float(n))), fract(float(i) * (PHI - 1.0)));
  return fract(base + gDUGIRSMJitter);
}

GIGatherSurface giTraceClosestHit(const in vec3 origin, const in vec3 direction, const in float tMin, const in float tMax, const in uint cullMask){
  GIGatherSurface s;
  s.position = origin + (direction * tMax);
  s.normal = -direction;
  s.albedo = vec3(0.0);
  s.emission = vec3(0.0);
  s.emissiveGIFactor = 1.0;
  s.emissiveGIMax = uintBitsToFloat(0x7f800000u);
  s.hitDistance = -1.0;
  s.hit = false;
  s.backface = false;
  s.doubleSided = false;

  vec3 albedoSum = vec3(0.0);
  vec3 positionSum = vec3(0.0);
  float distanceSum = 0.0;
  float weightSum = 0.0;

  // Representative (dominant) VPL normal: the lit RSM texel contributing most to this lobe. Used INSTEAD of an averaged normal
  // for shading, because giGatherShadeHit evaluates the unshadowed sun at this normal and an averaged normal can tilt past
  // N.L = 0 -> the sun-lit texel goes black. The dominant VPL is a real sun-visible surface (N.L > 0 by RSM construction).
  float bestWeight = 0.0;
  vec3 bestNormal = -direction;

  // Two-pass closest-hit gather (mirrors gi_dugi_rsm_splat.comp): a real ray hits only the NEAREST surface, so VPLs much
  // farther than the nearest lobe hit are behind it and must not bleed in. Pass 1 finds the nearest lobe VPL distance; pass 2
  // accumulates only VPLs within nearestDistance * NEAR_BAND, weighted alignment^sharpness / d^2 (the 1/d^2 is a SELECTION bias
  // towards the nearest, NOT a falloff on the stored albedo — it cancels in the normalized average).
  float nearestDistance = tMax;
  for(int sampleIndex = 0; sampleIndex < GI_DUGI_RSM_SAMPLES; sampleIndex++){
    vec2 uv = dugiRSMSampleUV(sampleIndex, GI_DUGI_RSM_SAMPLES);
    vec4 normalUsed = textureLod(uReflectiveShadowMapNormalUsed, uv, 0.0);
    if(normalUsed.w < 0.5){
      continue; // no surface rasterized into this RSM texel
    }
    float depth = textureLod(uReflectiveShadowMapDepth, uv, 0.0).x;
    vec4 worldPosition = rsm.reflectiveShadowMapToWorldMatrix * vec4(fma(uv, vec2(2.0), vec2(-1.0)), depth, 1.0);
    vec3 vplPosition = worldPosition.xyz / worldPosition.w;
    vec3 toVPL = vplPosition - origin;
    float distanceToVPL = length(toVPL);
    if((distanceToVPL < max(tMin, 1e-3)) || (distanceToVPL > tMax)){
      continue; // degenerate, or beyond this cascade's reach
    }
    vec3 directionToVPL = toVPL * (1.0 / distanceToVPL);
    vec3 vplNormal = normalize(fma(normalUsed.xyz, vec3(2.0), vec3(-1.0)));
    if(dot(-directionToVPL, vplNormal) <= 0.0){
      continue; // the VPL surface faces away from the probe
    }
    if(dot(direction, directionToVPL) <= 0.0){
      continue;
    }
    nearestDistance = min(nearestDistance, distanceToVPL);
  }

  float bandDistance = min(nearestDistance * GI_DUGI_RSM_NEAR_BAND, tMax); // clamp to the cascade reach (empty pass 1 => sky miss)
  for(int sampleIndex = 0; sampleIndex < GI_DUGI_RSM_SAMPLES; sampleIndex++){

    vec2 uv = dugiRSMSampleUV(sampleIndex, GI_DUGI_RSM_SAMPLES);

    vec4 normalUsed = textureLod(uReflectiveShadowMapNormalUsed, uv, 0.0);
    if(normalUsed.w < 0.5){
      continue; // no surface rasterized into this RSM texel
    }

    float depth = textureLod(uReflectiveShadowMapDepth, uv, 0.0).x;
    vec4 worldPosition = rsm.reflectiveShadowMapToWorldMatrix * vec4(fma(uv, vec2(2.0), vec2(-1.0)), depth, 1.0);
    vec3 vplPosition = worldPosition.xyz / worldPosition.w;

    vec3 toVPL = vplPosition - origin;
    float distanceToVPL = length(toVPL);
    if((distanceToVPL < max(tMin, 1e-3)) || (distanceToVPL > bandDistance)){
      continue; // degenerate, or behind the nearest lobe hit (beyond its near band)
    }
    vec3 directionToVPL = toVPL * (1.0 / distanceToVPL);

    vec3 vplNormal = normalize(fma(normalUsed.xyz, vec3(2.0), vec3(-1.0)));
    if(dot(-directionToVPL, vplNormal) <= 0.0){
      continue; // the VPL surface faces away from the probe
    }

    float alignment = max(dot(direction, directionToVPL), 0.0);
    if(alignment <= 0.0){
      continue;
    }
    float weight = pow(alignment, GI_DUGI_RSM_SHARPNESS) / max(distanceToVPL * distanceToVPL, 1e-4);

    if(weight > bestWeight){
      bestWeight = weight;
      bestNormal = vplNormal; // keep the dominant VPL's true normal for the sun N.L (see above)
    }

    vec3 albedo = max(vec3(0.0), textureLod(uReflectiveShadowMapColor, uv, 0.0).xyz);
    albedoSum += albedo * weight;
    positionSum += vplPosition * weight;
    distanceSum += distanceToVPL * weight;
    weightSum += weight;
  }

  if(weightSum > 1e-6){
    s.hit = true;
    s.albedo = albedoSum / weightSum;
    s.normal = bestNormal; // dominant VPL normal, not the averaged normal (sun N.L correctness; see above)
    s.position = positionSum / weightSum;
    s.hitDistance = distanceSum / weightSum;
  }
  return s;
}
#endif // GI_TRACE_BACKEND == GI_TRACE_BACKEND_RSM

// Optional multi-bounce: sample the previous frame's irradiance field at each ray hit and feed it back as the indirect
// term, giving "infinite" diffuse bounces. Compile-time toggle (default on) plus a runtime strength (push constant
// blend.y, 0 = effectively first-bounce only). Only the L1 SH storage variant is supported for the feedback read.
#ifndef GI_DUGI_MULTIBOUNCE
  #define GI_DUGI_MULTIBOUNCE 1
#endif

// DUGI probe field definition (UBO + addressing). With multi-bounce we also enable the probe sampling path.
#define GLOBAL_ILLUMINATION_VOLUME_UNIFORM_SET 1
#define GLOBAL_ILLUMINATION_VOLUME_UNIFORM_BINDING 0
#if GI_DUGI_MULTIBOUNCE
  #define GLOBAL_ILLUMINATION_DUGI_SAMPLE
#endif
#include "global_illumination_dugi.glsl"
#include "gi_dugi_raydata.glsl" // shared ray-data contract: dugiTraceRayDirection / dugiEncodeRayData / dugiRayIsFixed
// dugiData (SSBO: cascade globals + sub-buffer pointers) + the sub-buffer accessors come via global_illumination_dugi.glsl

// Per-ray output (rgb = radiance towards the probe, a = hit distance / signed for fixed rays) now lives in the master's
// ray-data BDA storage buffer (full precision, no image-format cap), written via dugiStoreRay below.

#include "gi_dugi_pushconstants.glsl"

// Shared previous-frame probe-field reads (set 1 binding 2/3) + the relocation offset + the SH irradiance loader — factored
// out so the non-raytraced RSM producers reuse exactly this machinery instead of duplicating it. (The reads are declared
// read-only here; the update stages overwrite these images only after this trace stage.)
#include "gi_dugi_multibounce.glsl"

void main(){

  uint rayIndex = gl_GlobalInvocationID.x;
  uint globalProbeIndex = gl_GlobalInvocationID.y;

  uint raysPerProbe = pushConstants.params.w;
  uint totalProbes = pushConstants.params.y * pushConstants.params.z;

  if((rayIndex >= raysPerProbe) || (globalProbeIndex >= totalProbes)){
    return;
  }

  // Publish the global GI-emissive master regulators (push) into the file-scope globals the gather's giGatherShadeHit reads.
  dugiEmissiveScale = pushConstants.emissiveGIParticleCount.x;
  dugiEmissiveMax = pushConstants.emissiveGIParticleCount.y;

  int cascadeIndex = int(globalProbeIndex / pushConstants.params.z);
  int probeIndexInCascade = int(globalProbeIndex % pushConstants.params.z);
  ivec3 probeCoord = dugiProbeCoordFromIndex(probeIndexInCascade); // physical storage slot

  // Toroidal scrolling: the iterated slot is physical; its world position comes from the logical lattice coordinate.
  ivec3 logicalProbeCoord = dugiProbeLogicalCoord(probeCoord, cascadeIndex);
  vec3 probePosition = dugiProbeGridToWorld(logicalProbeCoord, cascadeIndex);
#if GI_DUGI_PROBE_RELOCATION
  // Trace from the relocated probe position (the relocation pass pushed it out of any geometry it was embedded in), so the
  // gathered irradiance/visibility match the position the shading sampler reads it back at. The probe-data image is not
  // cleared on allocation, so on this slot's first frame (blend.z) it still holds uninitialized garbage -> skip the offset
  // until the relocation pass has written a (clamped) value at least once.
  if(pushConstants.blend.z < 0.5){
    probePosition += dugiLoadProbeData(probeCoord, cascadeIndex).xyz;
  }
#endif

  mat3 randomRotation = mat3(pushConstants.randomRotation0.xyz, pushConstants.randomRotation1.xyz, pushConstants.randomRotation2.xyz);
  vec3 rayDirection = dugiTraceRayDirection(rayIndex, randomRotation); // contract: fixed (unrotated) vs random (rotated)

  float tMin = 1e-3;
  float tMax = max(dugiData.dugiCascadeCellSizes[cascadeIndex].w, 1e-2);
  float cellSize = dugiData.dugiCascadeCellSizes[cascadeIndex].x;

  // Trace via the swappable backend (ray-query by default). Emissive meshes + all analytic lights + ray-traced shadows are
  // handled in the gather layer; optional multi-bounce feedback samples the previous frame's irradiance field at the hit.
#if GI_TRACE_BACKEND == 2
  // RSM backend: decorrelate the RSM sample taps per probe + ray + frame (see dugiRSMJitter) so the gather is not a fixed
  // global 64-tap pattern (which would leave permanent blind spots in a large RSM).
  gDUGIRSMJitter = dugiRSMJitter(uvec3(globalProbeIndex, rayIndex, uint(pushConstants.params.x)));
#endif
  GIGatherSurface surface = giTraceClosestHit(probePosition, rayDirection, tMin, tMax, CULLMASK_ALL);

  // Particle LBVH (not in the BLAS): a closest opaque particle nearer than the mesh hit becomes the closest surface — it
  // occludes, overrides the shaded radiance, and shortens the stored hit distance (so the visibility moments see it too).
  // Transparent/additive particles add emission without occluding, bounded by the final closest opaque distance.
  uint particleCount = uint(pushConstants.emissiveGIParticleCount.z);
  ParticleBVHEmitterRef particleEmitters = ParticleBVHEmitterRef(pushConstants.particleBVH.xy);
  ParticleBVHNodeRef particleNodes = ParticleBVHNodeRef(pushConstants.particleBVH.zw);
  bool effectiveHit = surface.hit;
  bool effectiveBackface = surface.backface;
  float effectiveHitDistance = surface.hit ? surface.hitDistance : tMax;
  float particleBound = effectiveHitDistance;
  vec3 particleOpaqueEmission = vec3(0.0);
  bool opaqueParticleCloser = false;
  if(particleCount > 0u){
    vec3 opaqueEmission;
    float opaqueT = particleBVHClosestOpaque(particleNodes, particleEmitters, probePosition, rayDirection, tMin, effectiveHitDistance, particleCount, opaqueEmission);
    if(opaqueT < effectiveHitDistance){
      opaqueParticleCloser = true;
      particleOpaqueEmission = opaqueEmission;
      particleBound = opaqueT;
      effectiveHit = true;
      effectiveBackface = false;
      effectiveHitDistance = opaqueT;
    }
  }

  // Shade only the random (blended) rays; fixed rays carry no radiance (the contract encodes only their signed distance).
  vec3 radiance = vec3(0.0);
  if(!dugiRayIsFixed(rayIndex)){
    if(surface.hit){
      if(surface.backface){
        // Backface hit: the probe sits behind/inside this surface (e.g. embedded in a thin ceiling/floor slab). Treat it as
        // absorptive (black) so the probe does not accumulate light it should not see — the key fix against emissive panels
        // bleeding through thin geometry to the other side. The stored distance is additionally shortened in the ray-data
        // encode (gi_dugi_raydata.glsl) so the visibility (Chebyshev) test registers this slab as a near occluder.
        radiance = vec3(0.0);
      }else{
        vec3 previousFrameIndirect = vec3(0.0);
#if GI_DUGI_MULTIBOUNCE
        float skyVisibilityUnused;
        previousFrameIndirect = dugiSampleIrradiance(surface.position, surface.normal, -rayDirection, skyVisibilityUnused) * pushConstants.blend.y;
        // The probe field is not cleared on allocation; ignore non-finite feedback so NaN/Inf cannot lock into the field.
        if(any(isnan(previousFrameIndirect)) || any(isinf(previousFrameIndirect))){
          previousFrameIndirect = vec3(0.0);
        }
#endif
        radiance = giGatherShadeHit(surface, previousFrameIndirect);
      }
    }else{
      radiance = GI_GATHER_SKY(rayDirection);
    }
    // Inject particles: opaque particle (if closer) replaces the surface radiance; additive particles add emission on top.
    if(particleCount > 0u){
      if(opaqueParticleCloser){
        radiance = particleOpaqueEmission;
      }
      radiance += particleBVHAdditiveEmission(particleNodes, particleEmitters, probePosition, rayDirection, tMin, particleBound, particleCount);
    }
    if(any(isnan(radiance)) || any(isinf(radiance))){
      radiance = vec3(0.0);
    }
  }

  // Encode per the shared ray-data contract (fixed -> signed/unclamped distance, no radiance; random -> shaded radiance +
  // backface-shortened, locally-clamped distance).
  DUGIRayDataBuffer rayData = dugiData.rayData; // launder through a local (readonly master field -> non-readonly ref)
  dugiStoreRay(rayData, globalProbeIndex, rayIndex, raysPerProbe,
               dugiEncodeRayData(rayIndex, radiance, effectiveHit, effectiveBackface, effectiveHitDistance, tMax, cellSize));
}
