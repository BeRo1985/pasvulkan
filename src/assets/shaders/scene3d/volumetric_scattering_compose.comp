#version 450 core

#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable
#extension GL_GOOGLE_include_directive : enable

// Volumetric scattering, step three: the half-resolution result goes back onto the full-resolution
// picture.
//
//   picture = inscattering + (extinction * picture)
//
// and not picture + inscattering. The same air that adds light also takes light away, and adding only the
// one half gives a veil laid over the world instead of air standing between the eye and it. Distance then
// never dims anything, however much haze is piled on top.
//
// The upsample is depth-aware, and that is where a half-resolution effect goes wrong if it is not: across
// a depth edge four samples belonging to two different distances get mixed, and a bright shaft crawls out
// over the silhouette of whatever is in front of it - the very halo the bilateral blur one step earlier
// went to the trouble of avoiding.
//
// Two ways of doing it, and which one runs is decided per pixel: where the four coarse depths all agree
// with the fine one there is nothing to weigh and a single sample is taken, and only at the edges - a few
// per cent of the picture - are the four gathered and weighted. The cheap path is the common one.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2DArray uTextureSource;       // the picture so far, full size
layout(set = 0, binding = 3) uniform sampler2DArray uTextureDepth;        // the resolved opaque depth

layout(set = 0, binding = 4, rgba16f) writeonly uniform image2DArray uDestinationTexture;

#ifdef VOLUMETRIC_SCATTERING_MSAA
// The RAW multisampled depth, before the resolve picked one sample for the whole pixel. Read per sample so
// that a silhouette pixel gets the mix its colour is actually made of - see the loop in main.
layout(set = 0, binding = 6) uniform sampler2DMSArray uTextureMSAADepth;
#endif

// The half-resolution buffers, the switches, and the upsample itself - shared with the fragment variant of
// this same pass, which runs at sample rate on the unresolved picture.
#include "volumetric_scattering_compose.glsl"

void main(){

  ivec3 destinationSize = imageSize(uDestinationTexture);
  ivec3 at = ivec3(gl_GlobalInvocationID.xyz);

  if(any(greaterThanEqual(at, destinationSize))){
    return;
  }

  vec4 here = texelFetch(uTextureSource, at, 0);

  if((pushConstants.flagsSampleCountSpare.x & VolumetricScatteringComposeFlagEnabled) == 0u){
    imageStore(uDestinationTexture, at, here);
    return;
  }

  // The four half-resolution texels around this pixel.
  ivec3 scatteringSize;
  ivec2 scatteringBase;
  vec2 scatteringFraction;
  scatteringFootprint(at.xy, destinationSize.xy, scatteringSize, scatteringBase, scatteringFraction);

  bool legacyLook = (pushConstants.flagsSampleCountSpare.x & VolumetricScatteringComposeFlagLegacyLook) != 0u;

  vec3 inscattering;
  vec3 extinction;

#ifdef VOLUMETRIC_SCATTERING_MSAA

  // Once per SAMPLE, over the raw multisampled depth, because the colour of a silhouette pixel is a
  // coverage mix of two surfaces while the resolved depth can only name one of them - and it names the
  // NEAREST, deliberately, since "is any part of this pixel in front" is the right question for an
  // occlusion test and the wrong one here.
  //
  // The GEOMETRY samples only, and averaged over those alone - which is what the fog pass beside us does,
  // and this follows it deliberately so the two can be judged against each other. Sky samples are skipped
  // entirely, so a pixel that is nine tenths sky still receives the scattering of the tenth of tower in
  // it, over its whole area.
  //
  // That is not the coverage mix, and it is worth being clear that it is not. For the fog it is invisible,
  // because the colour it blends toward is the horizon's and the sky half was nearly that colour already.
  // Here the two sample classes want very different things - at a mean free path of 1200 metres the sky's
  // transmittance over four kilometres is about 0.03 against 0.8 for a nearby tower - so the half that is
  // treated wrongly is treated very wrongly. Averaging over all samples instead trades a bright rim for a
  // dark one; neither is right without the per-sample COLOUR, which does not exist at this point in the
  // chain.
  int countSamples = max(1, int(pushConstants.flagsSampleCountSpare.y));

  inscattering = vec3(0.0);
  extinction = vec3(0.0);

  int countGeometrySamples = 0;

  for(int sampleIndex = 0; sampleIndex < countSamples; sampleIndex++){

    float rawDepth = texelFetch(uTextureMSAADepth, ivec3(at.xy, at.z), sampleIndex).x;

    // Sky, under the reversed infinite projection: raw depth exactly zero. Skipped, as the fog skips it.
    if(rawDepth <= 0.0){
      continue;
    }

    vec3 sampleInscattering, sampleExtinction;
    resolveScattering(at,
                      scatteringSize,
                      scatteringBase,
                      scatteringFraction,
                      linearDepth(rawDepth),
                      legacyLook,
                      sampleInscattering,
                      sampleExtinction);
    inscattering += sampleInscattering;
    extinction += sampleExtinction;
    countGeometrySamples++;

  }

  if(countGeometrySamples > 0){
    float sampleWeight = 1.0 / float(countGeometrySamples);
    inscattering *= sampleWeight;
    extinction *= sampleWeight;
  }else{
    // Every sample is sky, so there is no geometry to take the answer from - the pixel gets the sky's own,
    // which is what the resolved path would have given it anyway.
    resolveScattering(at,
                      scatteringSize,
                      scatteringBase,
                      scatteringFraction,
                      pushConstants.strengthZNearDepthWeightSkyDepth.w,
                      legacyLook,
                      inscattering,
                      extinction);
  }

#else

  // One sample per pixel, so the resolved depth IS the pixel's depth and there is nothing to average.
  resolveScattering(at,
                    scatteringSize,
                    scatteringBase,
                    scatteringFraction,
                    linearDepth(texelFetch(uTextureDepth, at, 0).x),
                    legacyLook,
                    inscattering,
                    extinction);

#endif

  imageStore(uDestinationTexture, at, composeScattering(here, inscattering, extinction));

}
