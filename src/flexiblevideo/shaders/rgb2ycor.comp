#version 450
// rgb2ycor.comp — RGB (packed uint8) -> YCoCg-R, written as raw INT, for the LOSSLESS 5/3 path
// (the integer forward wavelet reads int, no float). Same reversible transform as the CPU
// rgb_to_ycocg(); the lossy counterpart rgb2yco writes float bit-patterns instead.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer PackedRgb { uint packed_rgb[]; };   // rgba8: one 32-bit-aligned uint per pixel
layout(std430, binding = 1) buffer Luma         { int luma[]; };
layout(std430, binding = 2) buffer ChromaOrange { int chroma_orange[]; };
layout(std430, binding = 3) buffer ChromaGreen  { int chroma_green[]; };
layout(push_constant) uniform PushConstants { int width; int height; } push;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= uint(push.width * push.height)) {
    return;
  }
  uint px = packed_rgb[i];   // one aligned uint per pixel; the alpha byte (px >> 24) is not read here
  int r = int(px & 0xFFu);
  int g = int((px >> 8u) & 0xFFu);
  int b = int((px >> 16u) & 0xFFu);
  int co = r - b;
  int t = b + (co >> 1);
  int cg = g - t;
  int y = t + (cg >> 1);
  luma[i] = y;
  chroma_orange[i] = co;
  chroma_green[i] = cg;
}
