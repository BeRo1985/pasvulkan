#version 450
// dct_inv_qt.comp — inverse orthonormal N x N block DCT (float) for the ADAPTIVE QUADTREE path. ONE workgroup
// per leaf (sizes 8/16/32) driven by a host-built leaf list; local_size 32x32 (threads beyond the leaf size
// idle). Reads the dequantized DCT coefficients (float bit-patterns) and writes the reconstructed samples in
// place, exactly like dct_inv.comp but size-parameterized. Basis + index order match dct_inv.comp / the CPU
// inverse_dct_one (columns-then-rows; separable orthonormal). Used only when g_quadtree; dct_inv.comp untouched.
layout(local_size_x = 32, local_size_y = 32) in;
layout(std430, binding = 0)          buffer Plane  { float data[]; };
layout(std430, binding = 1) readonly buffer Leaves { uint leaves[]; };   // per leaf: x, y, size (3 uints)
layout(push_constant) uniform PushConstants { int width; int leaf_count; } push;

shared float basis[32][32];   // basis[frequency][sample] = alpha(frequency) * cos(((2*sample)+1)*frequency*pi/(2N))
shared float block[32][32];   // the loaded N x N coefficient block (block[v][u])
shared float cols[32][32];    // after the column (vertical) inverse pass

void main() {
  int leaf = int(gl_WorkGroupID.x);
  if (leaf >= push.leaf_count) {
    return;
  }
  int base_x = int(leaves[(leaf * 3) + 0]);
  int base_y = int(leaves[(leaf * 3) + 1]);
  int n = int(leaves[(leaf * 3) + 2]);

  int local_x = int(gl_LocalInvocationID.x);     // column index u / output column x ('sample' is a GLSL reserved word)
  int frequency = int(gl_LocalInvocationID.y);   // row index v / output row y
  bool in_leaf = (local_x < n) && (frequency < n);

  if (in_leaf) {
    float alpha = (frequency == 0) ? sqrt(1.0 / float(n)) : sqrt(2.0 / float(n));
    basis[frequency][local_x] = alpha * cos((float((2 * local_x) + 1) * float(frequency) * 3.14159265358979312) / (2.0 * float(n)));
    block[frequency][local_x] = data[(((base_y + frequency) * push.width) + base_x) + local_x];
  }
  barrier();

  // Column (vertical) inverse: cols[y][u] = sum_v basis[v][y] * block[v][u]   (thread: y = frequency, u = local_x)
  if (in_leaf) {
    float col_sum = 0.0;
    for (int v = 0; v < n; v++) {
      col_sum += basis[v][frequency] * block[v][local_x];
    }
    cols[frequency][local_x] = col_sum;
  }
  barrier();

  // Row (horizontal) inverse: out[y][x] = sum_u basis[u][x] * cols[y][u]   (thread: y = frequency, x = local_x)
  if (in_leaf) {
    float row_sum = 0.0;
    for (int u = 0; u < n; u++) {
      row_sum += basis[u][local_x] * cols[frequency][u];
    }
    data[(((base_y + frequency) * push.width) + base_x) + local_x] = row_sum;
  }
}
