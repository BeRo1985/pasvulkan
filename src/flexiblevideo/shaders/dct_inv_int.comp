#version 450
// dct_inv_int.comp — inverse REVERSIBLE INTEGER 8x8 block DCT (lifting, fixed-point F=12). The DCT-mode
// LOSSLESS spatial inverse (Phase A3), bit-exact mirror of the CPU inverse_int_dct_blocks (fvdref.c):
// columns-then-rows, each 1D inverse a sequence of 3-step lifting rotations. One workgroup per 8x8 block,
// 8 threads (a thread is a column in pass 1, a row in pass 2). Integer-only -> bit-exact vs the CPU
// (every K*value product fits int32 at F=12, so no int64 is needed). Reads/writes the int coefficient
// plane in place (the decode feeds it straight from the rANS unpack; no dequant/round in the lossless path).
layout(local_size_x = 8) in;
layout(std430, binding = 0) buffer Plane { int data[]; };
layout(push_constant) uniform PushConstants { int width; int height; } push;

const int FSHIFT = 12;
const int BIAS = 1 << (FSHIFT - 1);

// rotation tables {plane_a, plane_b, p, u} — MUST match fvdref intdct_even / intdct_odd.
const ivec4 even_rot[6] = ivec4[6](
  ivec4(0, 1, -2023, 3253), ivec4(0, 2, -1147, 2127), ivec4(0, 3, -565, 1108),
  ivec4(1, 2, 5686, -3885), ivec4(1, 3, 1602, -2780), ivec4(2, 3, -6130, 3784));
const ivec4 odd_rot[6] = ivec4[6](
  ivec4(0, 1, -1503, 2649), ivec4(0, 2, -847, 1625), ivec4(0, 3, -284, 565),
  ivec4(1, 2, 7378, -3476), ivec4(1, 3, 847, -1625), ivec4(2, 3, -11166, 2649));

shared int blk[8][8];   // [row][col]

int rmul(int k, int x) {
  return (k * x + BIAS) >> FSHIFT;   // floor-rounded fixed-point multiply; product fits int32 at F=12
}

// One 1D reversible integer inverse DCT in place (mirror of intdct_1d_inverse).
void idct_1d(inout int x[8]) {
  int s[4];
  int d[4];
  for (int m = 0; m < 4; m++) {
    s[m] = x[2 * m];
    d[m] = x[(2 * m) + 1];
  }
  // even sub-inverse (forward table order, each lifting step subtracted in reverse)
  for (int r = 0; r < 6; r++) {
    int ia = even_rot[r].x, ib = even_rot[r].y, p = even_rot[r].z, u = even_rot[r].w;
    s[ia] -= rmul(p, s[ib]);
    s[ib] -= rmul(u, s[ia]);
    s[ia] -= rmul(p, s[ib]);
  }
  // odd sub-inverse
  for (int r = 0; r < 6; r++) {
    int ia = odd_rot[r].x, ib = odd_rot[r].y, p = odd_rot[r].z, u = odd_rot[r].w;
    d[ia] -= rmul(p, d[ib]);
    d[ib] -= rmul(u, d[ia]);
    d[ia] -= rmul(p, d[ib]);
  }
  for (int n = 0; n < 4; n++) {
    x[n] = (s[n] + d[n]) / 2;          // sums[n]+/-diffs[n] is always even -> exact /2 (sign-safe)
    x[7 - n] = (s[n] - d[n]) / 2;
  }
}

void main() {
  int lane = int(gl_LocalInvocationID.x);   // 0..7
  int base_x = int(gl_WorkGroupID.x) * 8;
  int base_y = int(gl_WorkGroupID.y) * 8;

  for (int row = 0; row < 8; row++) {
    blk[row][lane] = data[(((base_y + row) * push.width) + base_x) + lane];
  }
  barrier();

  // pass 1: inverse each COLUMN (lane = column index)
  int column[8];
  for (int row = 0; row < 8; row++) {
    column[row] = blk[row][lane];
  }
  idct_1d(column);
  for (int row = 0; row < 8; row++) {
    blk[row][lane] = column[row];
  }
  barrier();

  // pass 2: inverse each ROW (lane = row index)
  int rowv[8];
  for (int c = 0; c < 8; c++) {
    rowv[c] = blk[lane][c];
  }
  idct_1d(rowv);
  for (int c = 0; c < 8; c++) {
    blk[lane][c] = rowv[c];
  }
  barrier();

  for (int c = 0; c < 8; c++) {
    data[(((base_y + lane) * push.width) + base_x) + c] = blk[lane][c];
  }
}
