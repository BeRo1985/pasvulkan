#version 450
// extract_alpha16.comp — HDR (rgba16 / rgba64) variant of extract_alpha: pull the 16-bit alpha lane out and map it to
// the 8-bit alpha coefficient plane (the alpha plane is ALWAYS 8-bit, per the codec's "alpha stays 8-bit" rule). Q0
// (lossless 5/3) writes the raw int, Q8 (lossy 9/7) writes a float bit-pattern, matching the int/float forward wavelet.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer PackedRgb { uint packed_rgb[]; };   // rgba16: TWO 32-bit words per pixel ([r|g], [b|a])
layout(std430, binding = 1) buffer Alpha { int alpha[]; };
layout(push_constant) uniform PushConstants { int width; int height; int lossless; } push;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= uint(push.width * push.height)) {
    return;
  }
  uint ba = packed_rgb[(i * 2u) + 1u];                    // little-endian: low 16 bits = blue, high 16 bits = alpha
  int a16 = int((ba >> 16u) & 0xFFFFu);                   // the 16-bit alpha lane
  int a = int((float(a16) * (255.0 / 65535.0)) + 0.5);   // 16-bit -> 8-bit (rounded); the alpha plane is 8-bit
  alpha[i] = (push.lossless != 0) ? a : floatBitsToInt(float(a));
}
