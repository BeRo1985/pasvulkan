#version 450
// rans_size_qt.comp — GPU rANS ENCODE of one coding tile for the ADAPTIVE QUADTREE path (mirror of
// rans_size.comp but quadtree-walked). ONE workgroup per coding tile, single serial invocation. Walks the
// tile's 32x32 regions, expands each region's partition code into leaves (8/16/32) in qt_leaves order,
// tokenizes each leaf (per-leaf zigzag + DC-DPCM tile-wide + AC run/size — byte-for-byte like the CPU
// dct_encode_plane g_active_qt path and rans_unpack_qt), reverse-rANS-encodes the symbols, and assembles
// [varint rans_length][rans bytes][raw bytes] into this tile's scratch slice (size -> tile_size[tile]). The
// scratch region layout + rans_pack are shared with the uniform path (the OUT region base is identical).
layout(local_size_x = 1) in;
layout(std430, binding = 0) readonly buffer Coeffs    { int coeffs[]; };       // quantized coefficient plane
layout(std430, binding = 1) readonly buffer Tables    { uint freq_table[]; };  // DC/AC norm+cum (RANS_GPU_* layout)
layout(std430, binding = 2)          buffer Scratch   { uint scratch[]; };     // per-tile working slice
layout(std430, binding = 3)          buffer Sizes     { uint tile_size[]; };   // out: per-tile blob byte length
layout(std430, binding = 4) readonly buffer Partition { uint partition_words[]; };
layout(push_constant) uniform PushConstants { int width; int height; int block_size; int scratch_stride; int qt_offset; int regions_x; } push;

#define RANS_PROB_BITS 12
#define RANS_M  4096u
#define RANS_L  8388608u          // 1 << 23
#define OFF_DC_NORM 0
#define OFF_DC_CUM  17
#define OFF_AC_NORM 34
#define OFF_AC_CUM  290
#define QT_REGION 32

int g_zig8[64];
int g_zig16[256];
int g_zig32[1024];

void build_zigzag8()  { int idx = 0; for (int d = 0; d < 15; d++)  { if ((d & 1) == 0) { int r = (d < 8)  ? d : 7;   int c = d - r; while ((r >= 0) && (c < 8))  { g_zig8[idx++]  = (r * 8)  + c; r--; c++; } } else { int c = (d < 8)  ? d : 7;   int r = d - c; while ((c >= 0) && (r < 8))  { g_zig8[idx++]  = (r * 8)  + c; r++; c--; } } } }
void build_zigzag16() { int idx = 0; for (int d = 0; d < 31; d++)  { if ((d & 1) == 0) { int r = (d < 16) ? d : 15;  int c = d - r; while ((r >= 0) && (c < 16)) { g_zig16[idx++] = (r * 16) + c; r--; c++; } } else { int c = (d < 16) ? d : 15;  int r = d - c; while ((c >= 0) && (r < 16)) { g_zig16[idx++] = (r * 16) + c; r++; c--; } } } }
void build_zigzag32() { int idx = 0; for (int d = 0; d < 63; d++)  { if ((d & 1) == 0) { int r = (d < 32) ? d : 31;  int c = d - r; while ((r >= 0) && (c < 32)) { g_zig32[idx++] = (r * 32) + c; r--; c++; } } else { int c = (d < 32) ? d : 31;  int r = d - c; while ((c >= 0) && (r < 32)) { g_zig32[idx++] = (r * 32) + c; r++; c--; } } } }

int zig_at(int n, int s) {
  if (n == 8)  { return g_zig8[s];  }
  if (n == 16) { return g_zig16[s]; }
  return g_zig32[s];
}

uint read_partition(int region_index) {
  uint pos = uint(push.qt_offset + region_index);
  return (partition_words[pos >> 2u] >> ((pos & 3u) * 8u)) & 0xffu;
}

int value_size(int value) {
  int magnitude = (value < 0) ? -value : value;
  int size = 0;
  while (magnitude > 0) {
    size++;
    magnitude >>= 1;
  }
  return size;
}

int leaf_coeff(int base_x, int base_y, int n, int k) {
  int position = zig_at(n, k);
  int row = position / n;
  int col = position - (row * n);
  return coeffs[(((base_y + row) * push.width) + base_x) + col];
}

// byte store/load addressed from a uint base (single-threaded RMW; tiles never share words).
void put_byte(int word_base, int byte_offset, uint value) {
  int word = word_base + (byte_offset >> 2);
  int shift = (byte_offset & 3) * 8;
  scratch[word] = (scratch[word] & ~(0xffu << shift)) | ((value & 0xffu) << shift);
}
uint get_byte(int word_base, int byte_offset) {
  return (scratch[word_base + (byte_offset >> 2)] >> ((byte_offset & 3) * 8)) & 0xffu;
}

// MSB-first raw-bit writer into the RAW region.
int g_raw_base;
int g_raw_byte;
int g_raw_bit;
void raw_begin(int word_base) {
  g_raw_base = word_base;
  g_raw_byte = 0;
  g_raw_bit = 0;
  put_byte(g_raw_base, 0, 0u);
}
void raw_put_bit(uint bit) {
  if (bit != 0u) {
    put_byte(g_raw_base, g_raw_byte, get_byte(g_raw_base, g_raw_byte) | (1u << (7 - g_raw_bit)));
  }
  g_raw_bit++;
  if (g_raw_bit == 8) {
    g_raw_bit = 0;
    g_raw_byte++;
    put_byte(g_raw_base, g_raw_byte, 0u);
  }
}
void raw_put_value(int value, int size) {
  if (size > 1) {
    int magnitude = (value < 0) ? -value : value;
    int low = magnitude - (1 << (size - 1));
    for (int b = size - 2; b >= 0; b--) {
      raw_put_bit(uint((low >> b) & 1));
    }
  }
  raw_put_bit((value < 0) ? 1u : 0u);
}
int raw_length() {
  return (g_raw_bit > 0) ? (g_raw_byte + 1) : g_raw_byte;
}

// ---- forward tokenize state (symbols into the SYM region + raw bits into the RAW region) ----
int g_sym_base;
int g_sym_count;
int g_dc_pred;

void tokenize_leaf(int base_x, int base_y, int n) {
  int total = n * n;
  int dc = leaf_coeff(base_x, base_y, n, 0);
  int dc_diff = dc - g_dc_pred;
  g_dc_pred = dc;
  int dc_size = value_size(dc_diff);
  scratch[g_sym_base + g_sym_count] = 0x8000u | uint(dc_size);
  g_sym_count++;
  if (dc_size > 0) {
    raw_put_value(dc_diff, dc_size);
  }
  int last_nonzero = 0;
  for (int k = 1; k < total; k++) {
    if (leaf_coeff(base_x, base_y, n, k) != 0) {
      last_nonzero = k;
    }
  }
  int run = 0;
  for (int k = 1; k <= last_nonzero; k++) {
    int value = leaf_coeff(base_x, base_y, n, k);
    if (value == 0) {
      run++;
      if (run == 16) {
        scratch[g_sym_base + g_sym_count] = 0xF0u;   // ZRL
        g_sym_count++;
        run = 0;
      }
      continue;
    }
    int ac_size = value_size(value);
    scratch[g_sym_base + g_sym_count] = uint((run << 4) | ac_size);
    g_sym_count++;
    raw_put_value(value, ac_size);
    run = 0;
  }
  if (last_nonzero < (total - 1)) {
    scratch[g_sym_base + g_sym_count] = 0u;   // EOB
    g_sym_count++;
  }
}

void tokenize_region(int region_x, int region_y, uint code, int bound_x, int bound_y) {
  if ((((region_x + 32) <= bound_x) && ((region_y + 32) <= bound_y)) && ((code & 1u) == 0u)) {
    tokenize_leaf(region_x, region_y, 32);
    return;
  }
  for (int qy = 0; qy < 2; qy++) {
    for (int qx = 0; qx < 2; qx++) {
      int quadrant = (qy * 2) + qx;
      int quad_x = region_x + (qx * 16);
      int quad_y = region_y + (qy * 16);
      if ((quad_x >= bound_x) || (quad_y >= bound_y)) {
        continue;
      }
      bool fits16 = ((quad_x + 16) <= bound_x) && ((quad_y + 16) <= bound_y);
      if (fits16 && (((code >> uint(1 + quadrant)) & 1u) == 0u)) {
        tokenize_leaf(quad_x, quad_y, 16);
      } else {
        for (int sy = 0; sy < 2; sy++) {
          for (int sx = 0; sx < 2; sx++) {
            int sub_x = quad_x + (sx * 8);
            int sub_y = quad_y + (sy * 8);
            if (((sub_x + 8) <= bound_x) && ((sub_y + 8) <= bound_y)) {
              tokenize_leaf(sub_x, sub_y, 8);
            }
          }
        }
      }
    }
  }
}

void main() {
  int tiles_x = (push.width + (push.block_size - 1)) / push.block_size;
  int tiles_y = (push.height + (push.block_size - 1)) / push.block_size;
  int tile = int(gl_WorkGroupID.x);
  if (tile >= (tiles_x * tiles_y)) {
    return;
  }
  int tile_x = (tile % tiles_x) * push.block_size;
  int tile_y = (tile / tiles_x) * push.block_size;
  int tile_w = min(push.block_size, push.width - tile_x);
  int tile_h = min(push.block_size, push.height - tile_y);

  build_zigzag8();
  build_zigzag16();
  build_zigzag32();

  // Region bases (uint indices) within this tile's slice — IDENTICAL to rans_size.comp so rans_pack is shared.
  int subs = (push.block_size / 8) * (push.block_size / 8);
  int sym_words = subs * 65;
  int rans_words = (subs * 33) + 4;
  int raw_words = (subs * 33);
  int slice = tile * push.scratch_stride;
  int sym_base = slice;
  int rans_base = sym_base + sym_words;
  int raw_base = rans_base + rans_words;
  int out_base = raw_base + raw_words;

  // ---- tokenize (forward): collect symbols (one uint each, bit15 = is_dc) + the raw bits ----
  raw_begin(raw_base);
  g_sym_base = sym_base;
  g_sym_count = 0;
  g_dc_pred = 0;
  int bound_x = tile_x + tile_w;
  int bound_y = tile_y + tile_h;
  for (int ry = 0; ry < tile_h; ry += QT_REGION) {
    for (int rx = 0; rx < tile_w; rx += QT_REGION) {
      int region_x = tile_x + rx;
      int region_y = tile_y + ry;
      uint code = read_partition((((region_y / QT_REGION) * push.regions_x) + (region_x / QT_REGION)));
      tokenize_region(region_x, region_y, code, bound_x, bound_y);
    }
  }
  int raw_bytes = raw_length();
  int sym_count = g_sym_count;

  // ---- reverse rANS encode: emit bytes DOWNWARD into the RANS region; the valid bytes end at the region top ----
  int rans_top = (rans_words * 4) - 1;
  int rans_cursor = rans_top;
  uint state = RANS_L;
  for (int i = sym_count - 1; i >= 0; i--) {
    uint s = scratch[sym_base + i];
    bool is_dc = (s & 0x8000u) != 0u;
    uint sym = s & 0x1ffu;
    uint freq = is_dc ? freq_table[OFF_DC_NORM + sym] : freq_table[OFF_AC_NORM + sym];
    uint cum  = is_dc ? freq_table[OFF_DC_CUM + sym]  : freq_table[OFF_AC_CUM + sym];
    uint x = state;
    uint x_max = ((RANS_L >> RANS_PROB_BITS) << 8) * freq;
    while (x >= x_max) {
      put_byte(rans_base, rans_cursor, x & 0xffu);
      rans_cursor--;
      x >>= 8;
    }
    state = (((x / freq) << RANS_PROB_BITS) + (x % freq)) + cum;
  }
  for (int b = 0; b < 4; b++) {   // flush the state, little-endian, below the renorm bytes
    put_byte(rans_base, rans_cursor, (state >> (8u * uint(3 - b))) & 0xffu);
    rans_cursor--;
  }
  int rans_first = rans_cursor + 1;
  int rans_length = (rans_top + 1) - rans_first;

  // ---- assemble [varint rans_length][rans bytes][raw bytes] into the OUT region ----
  int out_pos = 0;
  uint v = uint(rans_length);
  while (v >= 0x80u) {
    put_byte(out_base, out_pos, (v & 0x7fu) | 0x80u);
    out_pos++;
    v >>= 7;
  }
  put_byte(out_base, out_pos, v);
  out_pos++;
  for (int i = 0; i < rans_length; i++) {
    put_byte(out_base, out_pos, get_byte(rans_base, rans_first + i));
    out_pos++;
  }
  for (int i = 0; i < raw_bytes; i++) {
    put_byte(out_base, out_pos, get_byte(raw_base, i));
    out_pos++;
  }
  tile_size[tile] = uint(out_pos);
}
