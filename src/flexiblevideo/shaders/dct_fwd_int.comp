#version 450
// dct_fwd_int.comp — forward REVERSIBLE INTEGER 8x8 block DCT (lifting, fixed-point F=12). The DCT-mode
// LOSSLESS spatial forward, bit-exact mirror of the CPU forward_int_dct_blocks (fvdref.c):
// rows-then-columns, each 1D forward a sequence of 3-step lifting rotations applied in REVERSE table order.
// One workgroup per 8x8 block, 8 threads (a thread is a row in pass 1, a column in pass 2). Integer-only ->
// bit-exact vs the CPU (every K*value product fits int32 at F=12, so no int64 is needed). Reads/writes the
// int coefficient plane in place (the encode feeds it the color residual; no quant in the lossless path).
layout(local_size_x = 8) in;
layout(std430, binding = 0) buffer Plane { int data[]; };
layout(push_constant) uniform PushConstants { int width; int height; } push;

const int FSHIFT = 12;
const int BIAS = 1 << (FSHIFT - 1);

// rotation tables {plane_a, plane_b, p, u} — MUST match fvdref intdct_even / intdct_odd (and dct_inv_int.comp).
const ivec4 even_rot[6] = ivec4[6](
  ivec4(0, 1, -2023, 3253), ivec4(0, 2, -1147, 2127), ivec4(0, 3, -565, 1108),
  ivec4(1, 2, 5686, -3885), ivec4(1, 3, 1602, -2780), ivec4(2, 3, -6130, 3784));
const ivec4 odd_rot[6] = ivec4[6](
  ivec4(0, 1, -1503, 2649), ivec4(0, 2, -847, 1625), ivec4(0, 3, -284, 565),
  ivec4(1, 2, 7378, -3476), ivec4(1, 3, 847, -1625), ivec4(2, 3, -11166, 2649));

shared int blk[8][8];   // [row][col]

int rmul(int k, int x) {
  return (k * x + BIAS) >> FSHIFT;   // floor-rounded fixed-point multiply; product fits int32 at F=12
}

// One 1D reversible integer forward DCT in place (mirror of intdct_1d_forward).
void fdct_1d(inout int x[8]) {
  int s[4];
  int d[4];
  for (int n = 0; n < 4; n++) {
    s[n] = x[n] + x[7 - n];
    d[n] = x[n] - x[7 - n];
  }
  // even sub-forward (rotations in reverse table order; each lifting step a+=p*b; b+=u*a; a+=p*b)
  for (int r = 5; r >= 0; r--) {
    int ia = even_rot[r].x, ib = even_rot[r].y, p = even_rot[r].z, u = even_rot[r].w;
    s[ia] += rmul(p, s[ib]);
    s[ib] += rmul(u, s[ia]);
    s[ia] += rmul(p, s[ib]);
  }
  // odd sub-forward
  for (int r = 5; r >= 0; r--) {
    int ia = odd_rot[r].x, ib = odd_rot[r].y, p = odd_rot[r].z, u = odd_rot[r].w;
    d[ia] += rmul(p, d[ib]);
    d[ib] += rmul(u, d[ia]);
    d[ia] += rmul(p, d[ib]);
  }
  for (int m = 0; m < 4; m++) {
    x[2 * m] = s[m];
    x[(2 * m) + 1] = d[m];
  }
}

void main() {
  int lane = int(gl_LocalInvocationID.x);   // 0..7
  int base_x = int(gl_WorkGroupID.x) * 8;
  int base_y = int(gl_WorkGroupID.y) * 8;

  for (int row = 0; row < 8; row++) {
    blk[row][lane] = data[(((base_y + row) * push.width) + base_x) + lane];
  }
  barrier();

  // pass 1: forward each ROW (lane = row index)
  int rowv[8];
  for (int c = 0; c < 8; c++) {
    rowv[c] = blk[lane][c];
  }
  fdct_1d(rowv);
  for (int c = 0; c < 8; c++) {
    blk[lane][c] = rowv[c];
  }
  barrier();

  // pass 2: forward each COLUMN (lane = column index)
  int column[8];
  for (int row = 0; row < 8; row++) {
    column[row] = blk[row][lane];
  }
  fdct_1d(column);
  for (int row = 0; row < 8; row++) {
    blk[row][lane] = column[row];
  }
  barrier();

  for (int c = 0; c < 8; c++) {
    data[(((base_y + lane) * push.width) + base_x) + c] = blk[lane][c];
  }
}
